#!/bin/bash
# replicant: back up, restore and replicate an Omarchy 4 setup through
# a private GitHub repo that holds config, secrets and state. The panel under
# the bar icon drives this CLI and reads its state from `status --json`.
# shellcheck disable=SC2088 # "~" below is literal text and patterns, never an expansion
set -euo pipefail

REAL_BIN="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd -- "$(dirname -- "$REAL_BIN")/.." && pwd)"
CORE="$PLUGIN_DIR/bin/replicant-core.sh"
# fallback if running via a copy without the plugin dir
if [[ ! -f "$CORE" ]]; then
  installed_core="$HOME/.config/omarchy/plugins/io.github.tymurbogach.replicant/bin/replicant-core.sh"
  if [[ -f "$installed_core" ]]; then
    CORE="$installed_core"
    PLUGIN_DIR="$(cd -- "$(dirname -- "$installed_core")/.." && pwd)"
  fi
fi
PLUGIN_ID="io.github.tymurbogach.replicant"
REPLICANT_HOME="${OMARCHY_REPLICANT_HOME:-$HOME/.local/share/replicant}"
REPO_DIR="$REPLICANT_HOME/repo"
fail() { echo "replicant: $*" >&2; exit 1; }
info() { echo -e "\e[36m$*\e[0m" >&2; }
warn() { echo -e "\e[33m$*\e[0m" >&2; }
ok()   { echo -e "\e[32m$*\e[0m" >&2; }

# plural and replicant_machine are shared with the core, in one file.
[[ -f "$PLUGIN_DIR/bin/lib/common.sh" ]] || fail "bin/lib/common.sh not found under $PLUGIN_DIR"
# shellcheck source=bin/lib/common.sh
source "$PLUGIN_DIR/bin/lib/common.sh"
# shellcheck source=bin/lib/progress.sh
source "$PLUGIN_DIR/bin/lib/progress.sh"

progress_cli_exit() {
  local rc=$?
  [[ "${REPLICANT_PROGRESS_JSON:-0}" == 1 ]] || return "$rc"
  [[ "${REPLICANT_PROGRESS_RESULT_EMITTED:-0}" != 1 ]] || return "$rc"
  # Save owns its richer result because it knows whether the repository
  # committed locally, reached the remote, or had nothing to do.
  case "${REPLICANT_PROGRESS_COMMAND:-}" in save|save-file) return "$rc" ;; esac
  if (( rc == 0 )); then
    progress_result success "Command completed" ""
  elif (( rc == 130 || rc == 143 )); then
    progress_result cancelled "Cancelled" ""
  else
    progress_result failed "Command failed" ""
  fi
  return "$rc"
}

progress_cli_cancel() {
  local status=143
  trap '' INT TERM
  progress_result cancelled "Cancelled before the commit boundary" ""
  # The panel starts this CLI in its own session. Signal every child process
  # in that session, including git and age, so a cancelled save cannot keep
  # running after Quickshell stops waiting for it.
  if [[ "${REPLICANT_PROCESS_GROUP:-0}" == 1 ]]; then
    kill -TERM -- "-$$" 2>/dev/null || true
  fi
  exit "$status"
}

# Default name for `create`: <machine>-replicant, so that each machine gets its
# own private repo. The machine name is the core's, cut at the first dot. A
# machine called "omarchy", the distribution's default hostname, would get the
# name of this plugin's own repo, so it takes $USER instead.
_replicant_host=$(replicant_machine); _replicant_host="${_replicant_host%%.*}"
if [[ "$_replicant_host-replicant" == "replicant" ]]; then
  DEFAULT_REPO_NAME="${USER:-user}-replicant"
else
  DEFAULT_REPO_NAME="$_replicant_host-replicant"
fi

# Cache invalidation and every git invocation live in the core modules:
# briefcache_invalidate in bin/lib/briefcache.sh drops the brief-status
# cache, and the transaction engine in bin/lib/transaction.sh owns the
# repository mutations. This CLI parses, confirms, dispatches and renders,
# and it reaches the core through `load_core` or `bash "$CORE"`. A bare
# `git -C` here would be transaction ownership outside the engine.

# Serialize everything that writes to the repo. Without this, two commands
# racing (the panel firing `set` twice while a save is still committing)
# collide on .git/index.lock and one of them dies half-done. Commands queue
# instead of failing; 90s is far longer than any real operation here.
acquire_repo_lock() {
  mkdir -p -- "$REPLICANT_HOME" || fail "cannot create the Replicant lock directory: $REPLICANT_HOME"
  exec 9>"$REPLICANT_HOME/.replicant.lock" || fail "cannot open the Replicant lock file: $REPLICANT_HOME/.replicant.lock"
  # REPLICANT_LOCK_WAIT exists for the tests, which cannot wait 90 s per check.
  if ! flock -w "${REPLICANT_LOCK_WAIT:-90}" 9; then
    fail "another replicant operation is still running — try again in a moment"
  fi
}

ensure_core() { [[ -x "$CORE" ]] || fail "replicant-core.sh not found at $CORE"; }

# load_core: source the core for its functions, or stop with a message. Each
# command used `source "$CORE" 2>/dev/null || true`, which hid a syntax error
# in the core, and the next line then failed with a message about something
# else.
load_core() {
  ensure_core
  # shellcheck disable=SC1090
  source "$CORE" || fail "could not load $CORE"
}

cmd_status() { ensure_core; bash "$CORE" status "$@"; }
# changes: read-only review of what a save would commit. Prints pending repo
# paths, staged stats, and the selective-save hint. Writes nothing.
cmd_changes() {
  ensure_core
  load_core
  core_changes
}
# tx: resume or discard an abandoned save transaction, or list them.
cmd_tx() {
  ensure_core
  local sub="${1:-list}"; [[ "$sub" == -* ]] && sub="list"
  [[ "$sub" != "list" ]] && shift || true
  case "$sub" in
    list) bash "$CORE" tx-list ;;
    resume) [[ -n "${1:-}" ]] || fail "usage: replicant tx resume <uuid>"; bash "$CORE" tx-resume "$1" || exit 1; bash "$CORE" cache-invalidate ;;
    discard) [[ -n "${1:-}" ]] || fail "usage: replicant tx discard <uuid> [--force]"; bash "$CORE" tx-discard "$@" || exit 1; bash "$CORE" cache-invalidate ;;
    *) fail "usage: replicant tx list|resume <uuid>|discard <uuid> [--force]" ;;
  esac
}

cmd_init() {
  (( $# == 0 )) || fail "init accepts no options"
  ensure_core
  load_core
  core_init
}

cmd_login() {
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then ok "already logged in: $(gh auth status 2>&1 | head -n1)"; return 0; fi
    info "gh auth login..."; gh auth login --web --git-protocol https || gh auth login
  else fail "gh not installed: omarchy pkg add github-cli"; fi
}

json_string() {
  local value="${1:-}"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  printf '%s' "$value"
}

cmd_setup_status() {
  local installed=false authenticated=false reachable=false login=""
  local ssh_configured=false ssh_authenticated=false ssh_reachable=false
  local gh_login gh_status ssh_output

  if command -v gh >/dev/null 2>&1; then
    installed=true
    # Bounded like every other network call here: setup status gates the
    # panel's first screen, and `gh` sets no timeout itself.
    gh_status=$(timeout 10 gh auth status >/dev/null 2>&1; echo $?)
    if gh_login=$(timeout 10 gh api user --jq .login 2>/dev/null) && [[ -n "$gh_login" ]]; then
      authenticated=true; reachable=true; login="$gh_login"
    elif timeout 10 gh api rate_limit >/dev/null 2>&1; then
      reachable=true
    elif (( gh_status == 0 )); then
      authenticated=true
    fi
  fi

  if command -v ssh >/dev/null 2>&1; then
    local identity_file
    while read -r identity_file; do
      identity_file=${identity_file#identityfile }
      [[ -f "$identity_file" ]] && { ssh_configured=true; break; }
    done < <(ssh -G -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>/dev/null | grep '^identityfile ' || true)
    ssh_output=$(ssh -T -o BatchMode=yes -o ConnectTimeout=5 git@github.com 2>&1) || true
    case "$ssh_output" in
      *"successfully authenticated"*)
        ssh_configured=true; ssh_authenticated=true; ssh_reachable=true ;;
      *"Permission denied"*|*"permission denied"*)
        ssh_reachable=true ;;
      *"Connection timed out"*|*"Could not resolve hostname"*|*"Network is unreachable"*|*"Connection refused"*)
        ssh_reachable=false ;;
    esac
  fi
  if [[ "$ssh_authenticated" == true ]]; then ssh_configured=true; fi

  printf '{"default_repo_name":"%s",' "$(json_string "$DEFAULT_REPO_NAME")"
  printf '"github":{"installed":%s,"authenticated":%s,"reachable":%s,"login":"%s"},' \
    "$installed" "$authenticated" "$reachable" "$(json_string "$login")"
  printf '"ssh":{"configured":%s,"authenticated":%s,"reachable":%s}}\n' \
    "$ssh_configured" "$ssh_authenticated" "$ssh_reachable"
}

cmd_create() {
  local name="$DEFAULT_REPO_NAME" do_push=0 transport=https
  while (( $# )); do case "$1" in
    --private) shift;; # always private, ignore
    --public) warn "replicant is always private (it holds secrets/) — ignoring --public"; shift;;
    --push) do_push=1; shift;;
    --transport) transport="${2:-}"; shift 2;;
    --help|-h) echo "Usage: replicant create [name] [--push] [--transport https|ssh] (always --private)"; return 0;;
    -*) fail "unknown option: $1";;
    *) name="$1"; shift;;
  esac; done
  [[ $name =~ ^[A-Za-z0-9._-]+$ && ${#name} -le 100 && "$name" != "." && "$name" != ".." ]] || fail "invalid name: $name"
  [[ "$transport" == https || "$transport" == ssh ]] || fail "invalid transport: $transport"
  cmd_login
  ensure_core
  load_core
  repo_create "$name" "$do_push" "$transport" || fail "create failed"
}

# save — system -> repo -> GitHub.
# The panel has no field to type a commit message in, so from the panel a save
# could never commit anything: a save without -m deliberately leaves config
# and secrets copied-in-but-uncommitted, so a human can write one commit per
# change explaining WHY. That discipline is a terminal workflow. A button
# labelled "commit and push" that neither commits nor pushes is not — the user
# pressed Save, watched every badge stay exactly as red as before, and reported
# it as "it does not upload". It was doing what it was asked; nobody could ask
# it for the other thing.
#
# --auto writes the subject from the paths themselves. It says WHAT changed and
# never why, which is honest about what a button is able to know. Paths only:
# a file's name is not a secret (the panel lists them on screen already), a
# file's contents are, and those never reach a commit subject.
# save — everything through one transaction and one commit. The work happens
# in the core (bin/lib/save.sh); this parses and reports the outcome.
cmd_save() {
  ensure_core
  local rc=0
  bash "$CORE" save "$@" || rc=$?
  bash "$CORE" cache-invalidate
  return "$rc"
}

# `diff` with no id: what is pending in the repo as a whole. With an id it is
# cmd_open_diff instead, which compares one file. The read lives in the core
# (core_diff_summary); this keeps only the user-facing command syntax.
cmd_diff() {
  ensure_core
  # Without this the last core call exits non-zero into main() and the user
  # gets an empty header and a failure code, where every other command says
  # "no repo".
  [[ -d "$REPO_DIR/.git" ]] || fail "no repo yet — run 'create' or 'clone' first"
  load_core
  core_diff_summary
}

# edit/diff/reset by config id — used by the panel.
# The id -> real path mapping lives in the core (resolve_manifest_src) so the
# CLI, the panel's diff view and the core all resolve an id identically.
resolve_src() {
  load_core
  resolve_manifest_src "$1"
}

cmd_path() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: path <id>"
  resolve_src "$id" || fail "unknown id: $id"
}

# cmd_edit <id> [--wait]
#
# --wait holds until the editor is closed again, so the panel can come back to
# exactly where it was instead of leaving the user to reopen it. Only some
# editors can be waited on; the caller is told which happened rather than left
# to guess, because reopening a panel over a floating terminal editor would be
# worse than not reopening at all.
cmd_edit() {
  local id="" wait_for_editor=0 arg
  for arg in "$@"; do
    case "$arg" in
      --wait) wait_for_editor=1 ;;
      *) [[ -z "$id" ]] && id="$arg" ;;
    esac
  done
  [[ -n "$id" ]] || fail "usage: edit <id> [--wait]  (e.g. hypr/input.lua)"
  local src
  src=$(resolve_src "$id") || fail "unknown id: $id"
  if [[ ! -f "$src" ]]; then
    warn "$src doesn't exist — it will be created on edit"
    mkdir -p "$(dirname "$src")"
    touch "$src"
  fi
  # omarchy-launch-editor and nothing else. Not
  # omarchy-launch-floating-terminal-with-presentation (that wraps the command
  # in the Omarchy logo plus a "press a key to close" prompt — two extra
  # interactions to read one file) and not omarchy-launch-config-editor (which
  # adds a desktop notification per click). Editing a config should be: click,
  # editor. It detaches via setsid, so this returns immediately.
  # GUI editors that hold the command until their tab is closed. A terminal
  # editor is opened in a floating terminal that detaches, so there is nothing
  # to wait on without reimplementing Omarchy's own terminal launching.
  local editor=""
  [[ -f "$HOME/.local/state/omarchy/defaults/editor" ]] && read -r editor < "$HOME/.local/state/omarchy/defaults/editor"
  local can_wait=0
  case "${editor##*/}" in
    code|code-insiders|codium|vscodium|zed) can_wait=1 ;;
  esac

  if (( wait_for_editor && can_wait )) && command -v "$editor" >/dev/null 2>&1; then
    # `setsid --wait` gives the editor its own session, so a shell restart
    # cannot take an open file down with it, while still telling us when it
    # exits. uwsm-app keeps it in the same scope Omarchy would have used.
    if command -v uwsm-app >/dev/null 2>&1; then
      setsid --wait uwsm-app -- "$editor" --wait "$src" >/dev/null 2>&1 || true
    else
      setsid --wait "$editor" --wait "$src" >/dev/null 2>&1 || true
    fi
    # The caller reopens on this and only this. Silence means "not waited".
    echo "replicant:waited"
    return 0
  fi

  if command -v omarchy-launch-editor >/dev/null 2>&1; then
    omarchy-launch-editor "$src"
  else
    xdg-open "$src" 2>/dev/null || "${EDITOR:-nvim}" "$src"
  fi
}

cmd_open_diff() {
  local id="" against="auto"
  while (( $# )); do case "$1" in
    --against) against="${2:-auto}"; shift 2;;
    -*) fail "unknown option: $1";;
    *) id="$1"; shift;;
  esac; done
  [[ -n "$id" ]] || fail "usage: diff <id> [--against repo|default]"
  ensure_core
  # Plain text on stdout: the panel renders it inline.
  bash "$CORE" diff "$id" "$against"
}

cmd_reset() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: reset <id>  (restores the default via omarchy refresh)"
  load_core
  core_reset_one "$id" || fail "reset failed: $id"
}

# `push` means push.
#
# It used to mean "copy everything in, stage the lot with `add -A`, invent a
# commit message out of the current date, commit, push" — a second, worse
# save, inline in the dispatcher, that nothing called: not the panel, not
# the docs, not --help, not one test. It also took whatever arguments it was
# handed as the commit subject, which is how a commit titled "--help" reached
# GitHub.
#
# The bar reads "↑ 3 to push", so that is what the word has to do here: send
# the commits that already exist, and nothing else. Copying and committing
# first is save's job, and when there is uncommitted work this says so
# rather than quietly deciding on the user's behalf.
cmd_push() {
  ensure_core
  load_core
  repo_push
}

# Bringing down what another machine saved. Three things went wrong here and
# all three of them are about the same thing — a command that reports success
# it did not have:
#
#   * it stashed whatever was uncommitted and never popped it. Copied-in-but-
#     uncommitted is the NORMAL state after `backup`, so an ordinary pull moved
#     the user's pending work into a stash nobody was ever told to look in.
#   * `... || warn "conflicts"` and then `ok "pull OK"` unconditionally. A pull
#     that failed said it worked, in green.
#   * it never said what it brought. "pull OK" is the answer to a question
#     nobody asked; which of your files another machine changed is the answer
#     you came for — and it is also the only moment anything can know which
#     DIRECTION a difference points in, which is what record_incoming keeps.
cmd_pull() {
  ensure_core
  load_core
  repo_pull
}

cmd_clone() {
  local url="${1:-}"
  [[ -n "$url" ]] || { if [[ -t 0 ]]; then url=$(gum input --prompt "Git URL (private): " 2>/dev/null || true); fi; }
  ensure_core
  load_core
  repo_clone "$url"
}

# The restore and reset implementations live in bin/lib/restore.sh. Keep this
# get/set — curated per-field settings (SETTINGS registry in replicant-core.sh),
# distinct from edit/diff/reset which operate on whole tracked files
cmd_get() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: get <setting-id>"
  load_core
  get_setting_value "$id" || fail "unknown or unreadable setting: $id"
}

# Persist a setting through its owning entry, not every tracked file. A failed
# push can still leave a local commit, so check the saved value before we say
# that the setting was not saved and print the matching retry command. A scope
# of off is policy, not failure: the live value stays, nothing commits, and the
# result is a warning (amber) with the scope fix, never a red error.
cmd_save_setting() {
  local id="$1" value="$2" subject="$3" owner rc=0 saved=false scope=""
  local setting_entry setting_file warn_msg warn_detail warn_recovery
  local -a save_args=()
  if ! owner=$(setting_save_id "$id"); then
    setting_entry=$(find_setting "$id") || return 1
    setting_file=$(setting_field "$setting_entry" 3)
    warn_msg="Applied locally, not saved — $id has no tracked entry"
    warn_detail="The value is live on this machine. Track the file to save it."
    warn_recovery="replicant track $setting_file && replicant set $id $value"
    progress_result warning "$warn_msg. $warn_detail" "$warn_recovery"
    printf '%s\n%s Retry: %s\n' "$warn_msg" "$warn_detail" "$warn_recovery" >&2
    return 0
  fi
  scope=$(scope_for "$owner" 2>/dev/null || echo shared)
  if [[ "$scope" == "off" ]]; then
    warn_msg="Applied locally, not saved — $owner is switched off"
    warn_detail="The value is live on this machine. The repo keeps what it already has. Set $owner to Shared to save it."
    warn_recovery="replicant scope $owner shared"
    progress_result warning "$warn_msg. $warn_detail" "$warn_recovery"
    printf '%s\n%s\nRetry: %s\n' "$warn_msg" "$warn_detail" "$warn_recovery" >&2
    return 0
  fi
  save_args=(--id "$owner")
  cmd_save "${save_args[@]}" -m "$subject" || rc=$?
  (( rc == 0 )) && return 0

  setting_value_saved "$id" "$value" && saved=true
  if [[ "$saved" == true ]]; then
    echo "The setting $id is saved locally, but the push failed. Retry: replicant push" >&2
  else
    printf 'The setting %s changed on this machine but was not saved. Retry: replicant save --id %q -m %q\n' \
      "$id" "$owner" "$subject" >&2
  fi
  return "$rc"
}

cmd_set() {
  local id="${1:-}" value="${2:-}"
  [[ -n "$id" && -n "$value" ]] || fail "usage: set <setting-id> <value>"
  load_core
  set_setting_value "$id" "$value" || fail "could not set $id"
  # This is a real decision, so its owner gets one reasoned commit. Other live
  # files remain pending until their own save action.
  cmd_save_setting "$id" "$value" "config: $id = $value"
}

# save-file — commit and push exactly one tracked file. The panel's per-file
# Save: after editing one config you rarely want the "everything at once"
# save, and you always want the commit message to say which file it was.
# A transaction around one entry: the destination comes from the registry
# (never a second copy of that logic), secrets never land in config/, and a
# named file overrules the incoming hold-back.
cmd_save_file() {
  local id="${1:-}" msg=""
  shift || true
  while (( $# )); do case "$1" in -m|--message) msg="${2:-}"; shift 2;; *) shift;; esac; done
  [[ -n "$id" ]] || fail "usage: save-file <id> [-m \"why\"]"
  [[ -n "$msg" ]] || msg="config: update $id"
  cmd_save --id "$id" -m "$msg"
}

cmd_log() {
  local n=8 json=0
  while (( $# )); do case "$1" in
    -n) n="${2:-8}"; shift 2;;
    --json) json=1; shift;;
    *) shift;;
  esac; done
  ensure_core
  if (( json )); then bash "$CORE" log "$n"; else
    [[ -d "$REPO_DIR/.git" ]] || fail "no repo yet"
    load_core
    core_log_text "$n"
  fi
}

cmd_settings() {
  load_core
  if [[ "${1:-}" == "--json" ]]; then build_settings_json; return 0; fi
  # Values are printed the way the panel shows them — "10 min", not "600" —
  # because a list you read should not need arithmetic. `get` still answers in
  # the stored unit, which is what scripts want.
  local order; order=$(printf '%s\n' "${SETTING_GROUPS[@]}" | cut -d'|' -f1 | jq -Rsc 'split("\n") | map(select(length > 0))')
  build_settings_json | jq -r --argjson order "$order" '
    def pad($n): . + ("                                  "[0:($n - length)] // "");
    def bold: "\u001b[1m" + . + "\u001b[0m";
    group_by(.group) | sort_by(. as $g | ($order | index($g[0].group)) // 99) | .[] |
    (.[0].group | bold),
    (.[] | "  " + (.id | pad(26)) + " " + (.label | pad(30)) + " "
         + (if .available then .value_text + (if .implicit then "  (inherited)" else "" end)
            else "— not on this machine" end)
         + (if .can_revert_default then "   [omarchy: " + .default_text + "]" else "" end)),
    ""'
}

# cmd_apply <shell|hyprland|terminal> [--apply]: run what a settings change
# needs afterwards. A dry run by default, like every command that acts here:
# it prints the exact command and touches nothing. Nothing here writes to the
# repo, so no lock is taken.
cmd_apply() {
  local target="${1:-}"; shift || true
  load_core
  local DRY=1 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) DRY=0 ;;
      --dry-run) DRY=1 ;;
      *) fail "usage: replicant apply <shell|hyprland|terminal> [--apply]" ;;
    esac
  done
  case "$target" in
    shell|hyprland|terminal) ;;
    *) fail "usage: replicant apply <shell|hyprland|terminal> [--apply]" ;;
  esac
  if (( DRY )); then
    info "would run: $(apply_command_for "$target")"
    [[ "$target" == shell ]] && info "the shell restarts detached; the panel closes with it."
    echo >&2; skip "dry-run — nothing was touched. Repeat with --apply"
    return 0
  fi
  case "$target" in
    shell)
      command -v omarchy >/dev/null 2>&1 \
        || fail "apply shell: omarchy is not available on this machine — nothing was restarted."
      setsid -f omarchy restart shell </dev/null >/dev/null 2>&1 \
        || fail "apply shell: could not start 'omarchy restart shell'."
      info "shell restart started (detached). The shell — and this panel — closes and comes back."
      ;;
    hyprland)
      command -v hyprctl >/dev/null 2>&1 \
        || fail "apply hyprland: hyprctl is not available — Hyprland is not running here, and nothing was reloaded."
      local out rc=0
      out=$(hyprctl reload 2>&1) || rc=$?
      (( rc == 0 )) \
        || fail "apply hyprland: 'hyprctl reload' failed (exit $rc): ${out:-no output} — nothing was reloaded."
      local errs
      errs=$(hyprctl configerrors 2>/dev/null | grep -v '^no errors' || true)
      if [[ -n "$errs" ]]; then
        fail "apply hyprland: reloaded, but Hyprland reports config errors: $errs"
      fi
      info "Hyprland reloaded with no config errors."
      ;;
    terminal)
      command -v omarchy >/dev/null 2>&1 \
        || fail "apply terminal: omarchy is not available on this machine — nothing was restarted."
      local tout trc=0
      tout=$(omarchy restart terminal 2>&1) || trc=$?
      (( trc == 0 )) \
        || fail "apply terminal: 'omarchy restart terminal' failed (exit $trc): ${tout:-no output}"
      [[ -n "$tout" ]] && info "$tout"
      info "Terminals reloaded."
      ;;
  esac
}

# apply_command_for <target>: the exact command apply --apply would run. One
# place, so the preview and the action can never disagree.
apply_command_for() {
  case "$1" in
    shell) printf 'omarchy restart shell' ;;
    hyprland) printf 'hyprctl reload' ;;
    terminal) printf 'omarchy restart terminal' ;;
  esac
}
# cmd_scope <id> <shared|profile|off> changes one Configs row. One scope change, one
# commit of exactly that entry's paths: staging the directories would sweep
# every unrelated dotfile that happened to be pending into a commit whose
# message says "scope:", which is exactly the thing the data repo's
# one-commit-per-decision convention exists to prevent.
cmd_scope() {
  local id="${1:-}" want="${2:-}"
  [[ -n "$id" && -n "$want" ]] || fail "usage: replicant scope <id> shared|profile|off"
  load_core
  core_scope_transact "$id" "$want" || exit 1
  bash "$CORE" cache-invalidate
}

# cmd_policy — bulk policy changes use one validated core operation and one
# shape transaction. The `--` separator keeps ids unambiguous.
cmd_policy() {
  local action="${1:-}" scope="" id
  shift || true
  [[ "$action" == set ]] || fail "usage: policy set --scope <scope> -- <id...>"
  while (( $# )); do
    case "$1" in
      --scope) scope="${2:-}"; shift 2 ;;
      --) shift; break ;;
      *) fail "usage: policy set --scope <scope> -- <id...>" ;;
    esac
  done
  [[ -n "$scope" && $# -gt 0 ]] || fail "usage: policy set --scope <scope> -- <id...>"
  load_core
  core_policy_transact "$scope" "$@" || exit 1
  bash "$CORE" cache-invalidate
}

# cmd_bulk validates and applies one multi-entry action as one transaction.
# This parses and confirms (including every --yes gate); the transaction
# itself (worktree, candidate commit, push, activation) lives in
# core_bulk_transact in bin/lib/bulk.sh. The active repository changes only
# after the candidate commit exists and a push, when configured, succeeds.
cmd_bulk() {
  local action="${1:-}"; shift || true
  local yes=0 allow_large=0 scope="" kind=""
  local -a args=()
  while (( $# )); do
    case "$1" in
      --yes) yes=1; shift ;;
      --allow-large) allow_large=1; shift ;;
      --scope) scope="${2:-}"; shift 2 ;;
      --kind) kind="${2:-}"; shift 2 ;;
      --) shift; args+=("$@"); break ;;
      -*) fail "unknown option: $1" ;;
      *) args+=("$1"); shift ;;
    esac
  done
  [[ -n "$action" && ${#args[@]} -gt 0 ]] || fail "usage: bulk save|scope|track|convert-secret|untrack [options] -- <entries>"
  case "$action" in
    scope) [[ -n "$scope" ]] || fail "bulk scope requires --scope" ;;
    track) [[ "$kind" == config || "$kind" == secret ]] || fail "bulk track requires --kind config|secret" ;;
  esac
  case "$action" in
    untrack|convert-secret) (( yes )) || fail "bulk $action requires --yes" ;;
    scope) [[ "$scope" != off ]] || (( yes )) || fail "bulk scope off requires --yes" ;;
    track) (( yes )) || fail "bulk track requires --yes" ;;
  esac
  ensure_core
  local rc=0
  bash "$CORE" bulk-transact "$action" "$scope" "$kind" "$allow_large" -- "${args[@]}" || rc=$?
  bash "$CORE" cache-invalidate
  return "$rc"
}

# cmd_profile [name] — which profile this machine belongs to. With no argument
# it prints the current one and every profile the repo knows about.
# ─── track / untrack / suggest — the user's own list ────────────────────────
# Adding a file has to be one step, or the list stays whatever the plugin
# shipped with. These three are that step, from a terminal; the panel drives
# the same core functions.
cmd_track() {
  [[ $# -gt 0 ]] || fail "usage: replicant track <path> [name-in-repo] [--secret]"
  load_core
  core_track_transact "$@" || exit 1
  bash "$CORE" cache-invalidate
}

cmd_untrack() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: replicant untrack <id>"
  load_core
  core_untrack_transact "$id" || exit 1
  bash "$CORE" cache-invalidate
}

# cmd_key <subcommand> — the one shared age identity behind the vault: make
# it once, back it up outside the repo, adopt it on each new machine, check
# it, replace it. Init, import, rotate and export take the repo lock, so an
# export never reads a half-rotated identity. The recipient it names is repo
# content, so the commands that (re)write it commit that file through the
# transaction engine.
cmd_key() {
  local sub="${1:-}"
  if (( $# )); then shift; fi
  ensure_core
  case "$sub" in
    init) acquire_repo_lock; load_core; core_key_init_transact "$@" || exit 1 ;;
    import) acquire_repo_lock; load_core; core_key_import_transact "$@" || exit 1 ;;
    rotate) acquire_repo_lock; load_core; core_key_rotate_transact "$@" || exit 1 ;;
    export) acquire_repo_lock; bash "$CORE" key export "$@" || exit 1 ;;
    status) bash "$CORE" key status "$@" || exit 1 ;;
    *) fail "usage: replicant key init|export [--force] <dest>|import <src>|status|rotate" ;;
  esac
  bash "$CORE" cache-invalidate
}

# cmd_forget <id>: a file you deleted, and its copy leaves the repo too. One of
# your own entries is untracked; a shipped one keeps its place in the list.
cmd_forget() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: replicant forget <id>"
  load_core
  core_forget_transact "$id" || exit 1
  bash "$CORE" cache-invalidate
}

cmd_deleted() { ensure_core; bash "$CORE" deleted "$@"; }

# cmd_recover <sha> [--apply]: undo the deletions of one commit, in the repo and
# on this machine. A dry run by default, like every command that writes here.
cmd_recover() {
  local sha="" DRY=1 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) DRY=0 ;;
      --dry-run) DRY=1 ;;
      -*) fail "unknown option: $arg" ;;
      *) [[ -z "$sha" ]] && sha="$arg" ;;
    esac
  done
  [[ -n "$sha" ]] || fail "usage: replicant recover <sha> [--apply]  (the shas: replicant deleted)"
  [[ -d "$REPO_DIR/.git" ]] || fail "no repo yet"
  load_core
  if (( DRY )); then
    core_recover "$sha" "$DRY" || exit 1
    return 0
  fi
  core_recover_transact "$sha" || exit 1
  bash "$CORE" cache-invalidate
}

# ── the plugin itself ────────────────────────────────────────────────────────
cmd_update_check() { ensure_core; bash "$CORE" update-check "$@"; }

# cmd_update [--yes] [--restart]: install the newer version with Omarchy's own
# command. That command fast-forwards the checkout, validates the plugin, and
# rolls back when validation fails. This one adds the confirmation and, with
# --restart, the shell restart that loads the new code.
cmd_update() {
  local yes=0 restart=0 arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
      --restart) restart=1 ;;
      *) fail "unknown option: $arg" ;;
    esac
  done
  load_core
  local j cur lat
  j=$(core_update_check --fetch --json)
  cur=$(jq -r '.current' <<<"$j"); lat=$(jq -r '.latest' <<<"$j")
  [[ "$(jq -r '.checkout' <<<"$j")" == true ]] || fail "this copy of the plugin is not a git checkout, so it cannot update itself"
  [[ "$(jq -r '.installed' <<<"$j")" == true ]] || fail "this copy runs from $PLUGIN_DIR, which is not the installed plugin. Update it with git pull"
  if [[ "$(jq -r '.available' <<<"$j")" != true ]]; then ok "Replicant $cur is up to date"; return 0; fi
  [[ "$(jq -r '.dirty' <<<"$j")" != true ]] || fail "the installed plugin has local changes in $PLUGIN_DIR, and omarchy plugin update cannot fast-forward over them"
  echo "Replicant $cur -> ${lat:-newer}:" >&2
  jq -r '.commits[] | "  " + .sha + "  " + .subject' <<<"$j" >&2
  if (( ! yes )); then
    read -rp "Update now? [y/N] " resp </dev/tty 2>&1 || resp=""
    [[ $resp == [yY] ]] || fail "update cancelled"
  fi
  command -v omarchy >/dev/null 2>&1 || fail "omarchy not found"
  omarchy plugin update "$PLUGIN_ID" --yes >&2 || fail "omarchy plugin update failed. Nothing was changed"
  ok "updated to ${lat:-the newest version}"
  if (( restart )); then
    # Quickshell does not reliably notice that its compiled QML is stale
    # (CONTRIBUTING.md), and a restart on the old cache runs the old panel.
    rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/qmlcache"
    # Its own session: the shell that runs this command is the one that stops.
    setsid -f omarchy restart shell </dev/null >/dev/null 2>&1 || warn "could not restart the shell: run omarchy restart shell"
    info "cleared ${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/qmlcache; the shell restarts to load it"
  else
    info "restart the shell to load it: omarchy restart shell"
  fi
}

cmd_suggest() {
  local as_json=0
  while (( $# )); do case "$1" in --json) as_json=1; shift;; *) shift;; esac; done
  load_core
  if (( as_json )); then core_suggest --json; return 0; fi
  local path rel reason kind flag n=0
  while IFS=$'\t' read -r path rel reason kind; do
    [[ -n "$path" ]] || continue
    n=$((n + 1))
    flag=""; [[ "$kind" == secret ]] && flag=" --secret"
    printf '  \033[36m%s\033[0m\n      %s · track it with: replicant track %s%s\n' \
      "${path/#$HOME/\~}" "$reason" "${path/#$HOME/\~}" "$flag"
  done < <(core_suggest)
  if (( n == 0 )); then
    ok "nothing to suggest — everything worth tracking here already is"
  else
    echo
    info "$(plural "$n" file) not tracked yet. Nothing is added until you say so."
  fi
}

cmd_profile() {
  load_core
  local want="${1:-}"
  if [[ -z "$want" || "$want" == "list" ]]; then
    profile_report
    return $?
  fi
  core_profile_transact "$want" || exit 1
  bash "$CORE" cache-invalidate
}

# cmd_revert <setting-id> [--to default|repo] — put ONE setting back without
# touching the rest of the file it lives in. `reset` and `restore` are the
# whole-file hammers; this is the everyday one, and it is what the two small
# arrows next to every control in the panel call.
cmd_revert() {
  local id="${1:-}" to="default"
  shift || true
  while (( $# )); do case "$1" in --to) to="${2:-default}"; shift 2;; default|repo) to="$1"; shift;; *) shift;; esac; done
  [[ -n "$id" ]] || fail "usage: replicant revert <setting-id> [--to default|repo]"
  load_core
  core_revert "$id" "$to" || exit 1
  if [[ -d "$REPO_DIR/.git" ]]; then
    local value
    value=$(get_setting_value "$id") || exit 1
    cmd_save_setting "$id" "$value" "revert: $id -> $to"
  fi
}

# cmd_restore_file <id> — bring one tracked file back from the repo, backed up
# first. `reset <id>` is its twin, going to Omarchy's default instead.
cmd_restore_file() {
  local id="${1:-}"
  [[ -n "$id" ]] || fail "usage: replicant restore-file <id>"
  load_core
  core_restore_file "$id" || exit 1
}

# cmd_install_theme <name> — install ONE third-party theme recorded in the
# inventory, on request. `restore` reports these as pending and never installs
# them itself (see restore_themes below) — this is the explicit action.
cmd_install_theme() {
  local name="${1:-}"
  [[ -n "$name" ]] || fail "usage: replicant install-theme <name>"
  load_core
  core_install_theme "$name" || exit 1
}

# cmd_install_plugin <id> — the same action for a plugin.
cmd_install_plugin() {
  local id="" revision="" check_only=0 yes=0 arg
  while (( $# )); do
    arg="$1"; shift
    case "$arg" in
      --check) check_only=1 ;;
      --yes) yes=1 ;;
      --revision)
        (( $# )) || fail "--revision needs a full SHA"
        revision="$1"; shift ;;
      --revision=*) revision="${arg#--revision=}" ;;
      -*) fail "unknown option: $arg" ;;
      *) if [[ -z "$id" ]]; then id="$arg"; fi ;;
    esac
  done
  [[ -n "$id" ]] || fail "usage: replicant install-plugin <id> [--check|--revision <sha> --yes]"
  load_core
  # --check prints what the marketplace checked and where the origin is now,
  # and installs nothing. The panel asks this before it asks for consent.
  if (( check_only )); then
    [[ -z "$revision" && $yes -eq 0 ]] || fail "--check cannot be combined with --revision or --yes"
    core_plugin_verification "$id"; return 0
  fi
  (( yes == 1 )) || fail "install-plugin needs --yes after you select a revision"
  [[ "$revision" =~ ^[0-9a-fA-F]{40}$ ]] || fail "install-plugin needs --revision <full 40-character SHA>"
  core_install_plugin "$id" "$revision" || exit 1
}

# cmd_shortcuts — what you changed about the keyboard, and what is actually
# bound right now. Omarchy's model is defaults + your overrides, so only the
# overrides are backed up; a snapshot of all 227 active bindings would be stale
# the next time Omarchy updates.
cmd_shortcuts() {
  ensure_core
  if [[ "${1:-}" == "--json" ]]; then bash "$CORE" shortcuts; return 0; fi
  local json; json=$(bash "$CORE" shortcuts)
  printf '\033[1mYour own bindings\033[0m  (%s)\n' "$(jq -r '.file' <<<"$json")"
  local n; n=$(jq -r '.own_count' <<<"$json")
  if [[ "$n" == "0" ]]; then
    echo "  none — you are running Omarchy's defaults unchanged"
  else
    jq -r '.own[] | "  \(.key)\t\(if .kind == "unbind" then "(unbound)" else (if .description == "" then .command else .description end) end)"' <<<"$json" | expand -t 34
  fi
  printf '\n\033[1mActive right now\033[0m  (%s bindings, defaults included)\n' "$(jq -r '.active_count' <<<"$json")"
  jq -r '.active[] | "  \(.key)\t\(.description)"' <<<"$json" | expand -t 34
}

# Structured editors: keybindings, compose sequences, and the bar layout.
# Every mutation prints its unified preview first and writes only with
# --apply; --dry-run always wins over --apply. A save follows a successful
# write through the owning tracked entry, the way `set` does.
structured_effective_apply() {
  local a
  for a in "$@"; do [[ "$a" == "--dry-run" ]] && return 1; done
  for a in "$@"; do [[ "$a" == "--apply" ]] && return 0; done
  return 1
}

structured_without_flags() {
  local a
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && continue
    printf '%s\n' "$a"
  done
}

# structured_cli_save <owner-rel> <subject> — save the owning entry after a
# structured write, warning instead of saving when its scope is off.
structured_cli_save() {
  local owner="$1" subject="$2" scope rc=0
  scope=$(scope_for "$owner" 2>/dev/null || echo shared)
  if [[ "$scope" == "off" ]]; then
    warn "Applied locally, not saved — $owner is switched off."
    warn "The repo keeps what it already has. Set $owner to Shared to save it."
    warn "Retry: replicant scope $owner shared"
    return 0
  fi
  cmd_save --id "$owner" -m "$subject" || rc=$?
  if (( rc != 0 )); then
    echo "The change is on this machine but was not saved. Retry: replicant save --id $owner -m \"$subject\"" >&2
    return "$rc"
  fi
}

# structured_run <kind> <build-fn> <file> <owner> <subject> <adopt-fn> [adopt-arg]
# — build the candidate, preview it, and adopt on --apply. The build function
# prints the candidate full file to stdout. Returns 0 on preview or success.
structured_run() {
  local kind="$1" build="$2" file="$3" owner="$4" subject="$5" adopt="$6" hook="${7:-}"
  local inner cand old
  inner=$(mktemp) || fail "could not stage the $kind change"
  cand=$(mktemp) || { rm -f "$inner"; fail "could not stage the $kind change"; }
  # shellcheck disable=SC2064
  trap "rm -f '$inner' '$cand'" RETURN
  "$build" > "$cand" || { local rc=$?; trap - RETURN; rm -f "$inner" "$cand"; return "$rc"; }
  if [[ -f "$file" ]] && cmp -s -- "$file" "$cand"; then
    info "No change: $subject is already there."
    trap - RETURN; rm -f "$inner" "$cand"
    return 0
  fi
  old="$file"
  [[ -f "$old" ]] || old=/dev/null
  structured_preview "$file" "$old" "$cand"
  if ! structured_effective_apply "${STRUCTURED_ARGS[@]}"; then
    info "Preview only — nothing changed. Pass --apply to write it."
    trap - RETURN; rm -f "$inner" "$cand"
    return 0
  fi
  if [[ "$adopt" == "lua" ]]; then
    structured_adopt_lua "$file" "$cand" "$hook" || { local rc=$?; trap - RETURN; rm -f "$inner" "$cand"; return "$rc"; }
  elif [[ "$adopt" == "plain" ]]; then
    structured_adopt_plain "$file" "$cand" "$hook" || { local rc=$?; trap - RETURN; rm -f "$inner" "$cand"; return "$rc"; }
  elif [[ "$adopt" == "json" ]]; then
    backup_before_write "$file" || { trap - RETURN; rm -f "$inner" "$cand"; fail "could not back up $file"; }
    mkdir -p "$(dirname -- "$file")" || { trap - RETURN; rm -f "$inner" "$cand"; fail "could not write $file"; }
    cp -a -- "$cand" "$file" || { trap - RETURN; rm -f "$inner" "$cand"; fail "could not write $file"; }
    invalidate_file_maps
  fi
  ok "Applied: $subject."
  trap - RETURN; rm -f "$inner" "$cand"
  structured_cli_save "$owner" "$subject"
}

cmd_shortcut() {
  load_core
  local sub="${1:-}"; [[ -n "$sub" ]] || fail "usage: replicant shortcut list|add|disable|restore|remove ... (try --help)"
  shift || true
  STRUCTURED_ARGS=("$@")
  case "$sub" in
    list) structured_shortcut_list "$@" ;;
    add|disable|restore|remove) structured_shortcut_mutate "$sub" "$@" ;;
    *) fail "usage: replicant shortcut list|add|disable|restore|remove ... (try --help)" ;;
  esac
}

# structured_shortcut_mutate <op> [args] — parse, preview, and optionally
# adopt a shortcut change, then save hypr/bindings.lua.
structured_shortcut_mutate() {
  local op="$1"; shift
  local -a raw=() args=()
  local a desc="" keys="" cmd=""
  for a in "$@"; do raw+=("$a"); done
  while (( ${#raw[@]} )); do case "${raw[0]}" in
    --desc) desc="${raw[1]:-}"; raw=("${raw[@]:2}") ;;
    --apply|--dry-run) args+=("${raw[0]}"); raw=("${raw[@]:1}") ;;
    *) args+=("${raw[0]}"); raw=("${raw[@]:1}") ;;
  esac; done
  local file owner subject
  file=$(structured_bindings_file); owner="hypr/bindings.lua"
  case "$op" in
    add)
      (( ${#args[@]} >= 2 )) || fail "usage: replicant shortcut add <keys> <command> [--desc text] [--apply]"
      keys="${args[0]}"; cmd="${args[1]}"
      subject="shortcuts: add $keys"
      structured_shortcut_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        structured_shortcut_build add "$keys" "$desc" "$cmd" > "$inner" || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$STRUCT_SHORT_START" "$STRUCT_SHORT_END" "$inner" "$cand" \
          "-- Personal keybindings live here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    disable)
      (( ${#args[@]} >= 1 )) || fail "usage: replicant shortcut disable <keys> [--apply]"
      keys="${args[0]}"
      subject="shortcuts: disable $keys"
      structured_shortcut_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        structured_shortcut_build disable "$keys" > "$inner" || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$STRUCT_SHORT_START" "$STRUCT_SHORT_END" "$inner" "$cand" \
          "-- Personal keybindings live here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    restore)
      (( ${#args[@]} >= 1 )) || fail "usage: replicant shortcut restore <keys> [--apply]"
      keys="${args[0]}"
      subject="shortcuts: restore $keys"
      structured_shortcut_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        structured_shortcut_build restore "$keys" > "$inner" || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$STRUCT_SHORT_START" "$STRUCT_SHORT_END" "$inner" "$cand" \
          "-- Personal keybindings live here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    remove)
      (( ${#args[@]} >= 1 )) || fail "usage: replicant shortcut remove <keys> [--apply]"
      keys="${args[0]}"
      subject="shortcuts: remove $keys"
      structured_shortcut_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        structured_shortcut_build remove "$keys" > "$inner" || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$STRUCT_SHORT_START" "$STRUCT_SHORT_END" "$inner" "$cand" \
          "-- Personal keybindings live here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
  esac
  STRUCTURED_ARGS=()
  # The apply decision from the flags the user passed.
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && STRUCTURED_ARGS+=("$a")
  done
  structured_run shortcut structured_shortcut_add_build "$file" "$owner" "$subject" lua "hyprctl reload"
}

cmd_compose() {
  load_core
  local sub="${1:-}"; [[ -n "$sub" ]] || fail "usage: replicant compose list|add|remove ... (try --help)"
  shift || true
  case "$sub" in
    list) structured_compose_list "$@" ;;
    add|remove) structured_compose_mutate "$sub" "$@" ;;
    *) fail "usage: replicant compose list|add|remove ... (try --help)" ;;
  esac
}

# structured_compose_mutate <op> [args] — parse, preview, and optionally
# adopt a compose change, then save home/XCompose.
structured_compose_mutate() {
  local op="$1"; shift
  local -a args=()
  local a seq="" result=""
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && args+=("$a") || true
  done
  local -a pos=()
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && continue
    pos+=("$a")
  done
  local file owner subject
  file=$(structured_compose_file); owner="home/XCompose"
  case "$op" in
    add)
      (( ${#pos[@]} >= 2 )) || fail "usage: replicant compose add '<sequence>' '<result>' [--apply]"
      seq="${pos[0]}"; result="${pos[1]}"
      subject="compose: add $seq"
      ;;
    remove)
      (( ${#pos[@]} >= 1 )) || fail "usage: replicant compose remove '<sequence>' [--apply]"
      seq="${pos[0]}"
      subject="compose: remove $seq"
      ;;
  esac
  structured_compose_add_build() {
    local inner cand
    inner=$(mktemp) || return 1
    cand=$(mktemp) || { rm -f "$inner"; return 1; }
    if [[ "$op" == "add" ]]; then
      structured_compose_build add "$seq" "$result" > "$inner" || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
    else
      structured_compose_build remove "$seq" > "$inner" || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
    fi
    structured_block_candidate "$file" "$STRUCT_COMP_START" "$STRUCT_COMP_END" "$inner" "$cand" \
      "$(printf '# Personal compose sequences live here. Replicant owns only the managed block below.\ninclude "/usr/share/omarchy/default/xcompose"')" \
      || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
    cat -- "$cand"; rm -f "$inner" "$cand"
  }
  STRUCTURED_ARGS=("${args[@]}")
  structured_run compose structured_compose_add_build "$file" "$owner" "$subject" plain "omarchy-restart-xcompose"
}

cmd_bar_layout() {
  load_core
  local sub="${1:-}"; [[ -n "$sub" ]] || fail "usage: replicant bar-layout list|move|enable|disable|spacer ... (try --help)"
  shift || true
  case "$sub" in
    list) structured_bar_list "$@" ;;
    move|enable|disable|spacer) structured_bar_mutate "$sub" "$@" ;;
    *) fail "usage: replicant bar-layout list|move|enable|disable|spacer ... (try --help)" ;;
  esac
}

# structured_bar_mutate <op> [args] — parse, preview, and optionally adopt a
# bar layout change, then save omarchy/shell.json. The shell watches the
# file, so no reload command is needed.
structured_bar_mutate() {
  local op="$1"; shift
  local -a args=()
  local a
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && args+=("$a") || true
  done
  local -a pos=()
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && continue
    pos+=("$a")
  done
  local file owner subject
  file=$(structured_shell_file); owner="omarchy/shell.json"
  case "$op" in
    move)
      (( ${#pos[@]} >= 1 )) || fail "usage: replicant bar-layout move <widget> --section <s> [--before x|--after x|--index n] [--apply]"
      subject="bar: move ${pos[0]}"
      ;;
    enable)
      (( ${#pos[@]} >= 1 )) || fail "usage: replicant bar-layout enable <id> --section <s> [--apply]"
      subject="bar: enable ${pos[0]}"
      ;;
    disable)
      (( ${#pos[@]} >= 1 )) || fail "usage: replicant bar-layout disable <widget> [--apply]"
      subject="bar: disable ${pos[0]}"
      ;;
    spacer)
      subject="bar: add spacer"
      ;;
  esac
  STRUCTURED_ARGS=("${args[@]}")
  # Pass the placement options through: they are positional-or-flag args the
  # builder parses itself.
  local -a passthrough=()
  for a in "$@"; do
    [[ "$a" == "--apply" || "$a" == "--dry-run" ]] && continue
    passthrough+=("$a")
  done
  structured_bar_add_build() {
    structured_bar_build "$op" "${passthrough[@]}"
  }
  structured_run bar-layout structured_bar_add_build "$file" "$owner" "$subject" json
}

cmd_workspace() {
  load_core
  local sub="${1:-}"; [[ -n "$sub" ]] || fail "usage: replicant workspace list|define|undefine|count|app-add|app-remove|assign|unassign ... (try --help)"
  shift || true
  case "$sub" in
    list) desktop_workspace_list "$@" ;;
    define|undefine|count|app-add|app-remove|assign|unassign) desktop_workspace_mutate "$sub" "$@" ;;
    *) fail "usage: replicant workspace list|define|undefine|count|app-add|app-remove|assign|unassign ... (try --help)" ;;
  esac
}

# desktop_workspace_mutate <op> [args] — parse, preview, and optionally adopt
# a workspace change, then save the owning entry. Structure and app rules
# save hypr/hyprland.lua (shared); assignments save hypr/monitors.lua.
desktop_workspace_mutate() {
  local op="$1"; shift
  local -a flags=() pos=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--apply" || "$a" == "--dry-run" ]]; then flags+=("$a"); else pos+=("$a"); fi
  done
  local -a opts=()
  local name="" layout="" persistent="" def=false
  while (( ${#pos[@]} )); do case "${pos[0]}" in
    --name) name="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --layout) layout="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --persistent) persistent="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --default) def=true; pos=("${pos[@]:1}") ;;
    *) opts+=("${pos[0]}"); pos=("${pos[@]:1}") ;;
  esac; done
  local file owner subject
  case "$op" in
    define)
      (( ${#opts[@]} >= 1 )) || fail "usage: replicant workspace define <n> [--name X] [--layout L] [--persistent on|off] [--apply]"
      file=$(desktop_hyprland_file); owner="hypr/hyprland.lua"; subject="workspaces: define ${opts[0]}"
      desktop_ws_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        desktop_ws_build define "${opts[0]}" "$name" "$layout" "$persistent" > "$inner" \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$DESK_WS_START" "$DESK_WS_END" "$inner" "$cand" \
          "-- Personal workspace structure lives here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    undefine)
      (( ${#opts[@]} >= 1 )) || fail "usage: replicant workspace undefine <n> [--apply]"
      file=$(desktop_hyprland_file); owner="hypr/hyprland.lua"; subject="workspaces: undefine ${opts[0]}"
      # Orphaned app rules keep pointing at the workspace; say so before.
      local apps orphan=""
      apps=$(desktop_app_rows "$file" 2>/dev/null || true)
      while IFS=$'\037' read -r c w mgd; do
        [[ "$w" == "${opts[0]}" ]] || continue
        orphan+="$c "
      done <<<"$apps"
      [[ -z "$orphan" ]] || warn "App rules still target workspace ${opts[0]}: ${orphan}(they open it on demand)"
      desktop_ws_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        desktop_ws_build undefine "${opts[0]}" > "$inner" \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$DESK_WS_START" "$DESK_WS_END" "$inner" "$cand" \
          "-- Personal workspace structure lives here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    count)
      (( ${#opts[@]} >= 1 )) || fail "usage: replicant workspace count <n> [--apply]"
      file=$(desktop_hyprland_file); owner="hypr/hyprland.lua"; subject="workspaces: keep ${opts[0]}"
      desktop_ws_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        desktop_count_build "${opts[0]}" > "$inner" \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$DESK_WS_START" "$DESK_WS_END" "$inner" "$cand" \
          "-- Personal workspace structure lives here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    app-add|app-remove)
      if [[ "$op" == app-add ]]; then
        (( ${#opts[@]} >= 2 )) || fail "usage: replicant workspace app-add <class> <n> [--apply]"
      else
        (( ${#opts[@]} >= 1 )) || fail "usage: replicant workspace app-remove <class> [--apply]"
      fi
      file=$(desktop_hyprland_file); owner="hypr/hyprland.lua"; subject="workspaces: $op ${opts[0]}"
      # Opening on an undefined workspace works, but say so before.
      if [[ "$op" == app-add ]]; then
        local srows have=0
        srows=$(desktop_ws_rows "$file" "$DESK_WS_START" "$DESK_WS_END" 2>/dev/null || true)
        while IFS=$'\037' read -r w m d _p _n _l mgd; do
          [[ "$w" == "${opts[1]}" && "$mgd" == "1" && -z "$m" ]] && have=1
        done <<<"$srows"
        (( have )) || warn "No workspace ${opts[1]} is defined — the app opens it on demand"
      fi
      desktop_ws_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        desktop_app_build "$op" "${opts[0]}" "${opts[1]:-}" > "$inner" \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        structured_block_candidate "$file" "$DESK_APP_START" "$DESK_APP_END" "$inner" "$cand" \
          "-- Personal application rules live here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
    assign|unassign)
      if [[ "$op" == assign ]]; then
        (( ${#opts[@]} >= 2 )) || fail "usage: replicant workspace assign <n> <monitor> [--default] [--apply]"
      else
        (( ${#opts[@]} >= 1 )) || fail "usage: replicant workspace unassign <n> [--apply]"
      fi
      file=$(desktop_monitors_file); owner="hypr/monitors.lua"; subject="workspaces: $op ${opts[0]}"
      if [[ "$op" == assign ]] && command -v hyprctl >/dev/null 2>&1; then
        desktop_monitor_connected "${opts[1]}" 2>/dev/null \
          || warn "'${opts[1]}' is not connected now — stored for when it appears"
      fi
      if [[ "$op" == assign && "$def" == true ]]; then
        # One default per monitor: clear it from the other workspaces first.
        local arows
        arows=$(desktop_ws_rows "$file" "$DESK_ASG_START" "$DESK_ASG_END" 2>/dev/null || true)
        while IFS=$'\037' read -r w m d _p _n _l mgd; do
          [[ "$m" == "${opts[1]}" && "$d" == true && "$mgd" == 1 && "$w" != "${opts[0]}" ]] || continue
          warn "Workspace $w was the default on ${opts[1]} — it no longer is"
        done <<<"$arows"
      fi
      desktop_ws_add_build() {
        local inner cand
        inner=$(mktemp) || return 1
        cand=$(mktemp) || { rm -f "$inner"; return 1; }
        if [[ "$op" == assign ]]; then
          desktop_asg_build assign "${opts[0]}" "${opts[1]}" "$([ "$def" == true ] && echo true || echo false)" > "$inner" \
            || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        else
          desktop_asg_build unassign "${opts[0]}" > "$inner" \
            || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        fi
        # Clearing a previous default for the same monitor happens here, so
        # the preview shows the whole swap.
        if [[ "$op" == assign && "$def" == true ]]; then
          local filtered="$inner.filtered"
          awk -v mon="${opts[1]}" -v ws="${opts[0]}" '
            $0 ~ "workspace[[:space:]]*=[[:space:]]*\"" ws "\"" { print; next }
            $0 ~ "monitor[[:space:]]*=[[:space:]]*\"" mon "\"" {
              gsub(/,[[:space:]]*default[[:space:]]*=[[:space:]]*true/, "")
              gsub(/default[[:space:]]*=[[:space:]]*true[[:space:]]*,?/, "")
            }
            { print }
          ' "$inner" > "$filtered" 2>/dev/null && mv -- "$filtered" "$inner" || true
        fi
        structured_block_candidate "$file" "$DESK_ASG_START" "$DESK_ASG_END" "$inner" "$cand" \
          "-- Personal workspace assignments live here. Replicant owns only the managed block below." \
          || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
        cat -- "$cand"; rm -f "$inner" "$cand"
      }
      ;;
  esac
  STRUCTURED_ARGS=("${flags[@]}")
  export STRUCTURED_REDACT=1
  structured_run workspace desktop_ws_add_build "$file" "$owner" "$subject" lua "hyprctl reload"
  export STRUCTURED_REDACT=0
}

cmd_display() {
  load_core
  local sub="${1:-}"; [[ -n "$sub" ]] || fail "usage: replicant display list|set|enable|disable|remove|default ... (try --help)"
  shift || true
  case "$sub" in
    list) desktop_display_list "$@" ;;
    set|enable|disable|remove|default) desktop_display_mutate "$sub" "$@" ;;
    *) fail "usage: replicant display list|set|enable|disable|remove|default ... (try --help)" ;;
  esac
}

# desktop_display_mutate <op> [args] — parse, preview (with capability
# notes), and optionally adopt a display change, then save hypr/monitors.lua.
desktop_display_mutate() {
  local op="$1"; shift
  local -a flags=() pos=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--apply" || "$a" == "--dry-run" ]]; then flags+=("$a"); else pos+=("$a"); fi
  done
  local -a opts=()
  local mode="" scale="" transform="" position="" mirror="" vrr="" hdr="" nohdr=""
  while (( ${#pos[@]} )); do case "${pos[0]}" in
    --mode) mode="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --scale) scale="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --rotation|--transform) transform="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --position) position="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --mirror) mirror="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --vrr) vrr="${pos[1]:-}"; pos=("${pos[@]:2}") ;;
    --hdr) hdr=1; pos=("${pos[@]:1}") ;;
    --no-hdr) nohdr=1; pos=("${pos[@]:1}") ;;
    *) opts+=("${pos[0]}"); pos=("${pos[@]:1}") ;;
  esac; done
  (( ${#opts[@]} >= 1 )) || fail "usage: replicant display $op <monitor> [options] [--apply]"
  local file owner subject
  file=$(desktop_monitors_file); owner="hypr/monitors.lua"
  subject="display: $op ${opts[0]}"
  desktop_mon_add_build() {
    local inner cand
    inner=$(mktemp) || return 1
    cand=$(mktemp) || { rm -f "$inner"; return 1; }
    local -a bargs=("$op" "${opts[0]}")
    [[ -z "$mode" ]] || bargs+=(--mode "$mode")
    [[ -z "$scale" ]] || bargs+=(--scale "$scale")
    [[ -z "$transform" ]] || bargs+=(--transform "$transform")
    [[ -z "$position" ]] || bargs+=(--position "$position")
    [[ -z "$mirror" ]] || bargs+=(--mirror "$mirror")
    [[ -z "$vrr" ]] || bargs+=(--vrr "$vrr")
    [[ -z "$hdr" ]] || bargs+=(--hdr)
    [[ -z "$nohdr" ]] || bargs+=(--no-hdr)
    desktop_mon_build "${bargs[@]}" > "$inner" \
      || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
    structured_block_candidate "$file" "$DESK_MON_START" "$DESK_MON_END" "$inner" "$cand" \
      "-- Personal display entries live here. Replicant owns only the managed block below." \
      || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
    cat -- "$cand"; rm -f "$inner" "$cand"
  }
  # Availability first: a mode the monitor never offered cannot apply.
  if [[ "$op" == set || "$op" == default ]]; then
    local target="${opts[0]}"
    if desktop_monitor_connected "$target" 2>/dev/null; then
      info "Capability: $target is connected with $(desktop_monitor_modes "$target" 2>/dev/null | wc -l) modes."
      if [[ -n "$mode" ]]; then
        if desktop_mode_ok "$target" "$mode" 2>/dev/null; then
          info "Capability: mode $mode is offered by $target."
        else
          echo "display: mode $mode is not offered by $target — pick one of:" >&2
          desktop_monitor_modes "$target" 2>/dev/null | sed 's/^/  /' >&2 || true
          return 1
        fi
      fi
      if [[ -n "$mirror" ]]; then
        if [[ "$mirror" == "$target" ]]; then
          echo "display: a monitor cannot mirror itself" >&2; return 1
        fi
        desktop_monitor_connected "$mirror" 2>/dev/null \
          || { echo "display: mirror target '$mirror' is not connected" >&2; return 1; }
      fi
    else
      if [[ "$op" == set ]]; then
        echo "display: '$target' is not connected — connect it, or manage it with disable/remove" >&2
        return 1
      fi
      warn "'$target' is not connected now — stored for when it appears"
    fi
    # Same physical output, two owners: the managed block wins, so say so.
    local mrows
    mrows=$(desktop_mon_rows "$file" 2>/dev/null || true)
    while IFS=$'\037' read -r o _mo _sc _tr _po _mi _bd _vr _dis mgd; do
      [[ "$mgd" == 1 ]] && continue
      [[ -z "$o" ]] && continue
      if [[ "$o" == "$target" ]]; then
        warn "Your file already configures '$target' outside the managed block — the managed entry wins"
        break
      fi
    done <<<"$mrows"
  fi
  STRUCTURED_ARGS=("${flags[@]}")
  export STRUCTURED_REDACT=1
  local rc=0
  if [[ "$op" == default ]]; then
    # The default monitor is workspace 1 with default=true in this profile.
    desktop_ws_add_build() {
      local inner cand
      inner=$(mktemp) || return 1
      cand=$(mktemp) || { rm -f "$inner"; return 1; }
      desktop_asg_build assign "1" "${opts[0]}" true > "$inner" \
        || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
      structured_block_candidate "$file" "$DESK_ASG_START" "$DESK_ASG_END" "$inner" "$cand" \
        "-- Personal workspace assignments live here. Replicant owns only the managed block below." \
        || { local rc=$?; rm -f "$inner" "$cand"; return "$rc"; }
      cat -- "$cand"; rm -f "$inner" "$cand"
    }
    structured_run display desktop_ws_add_build "$file" "$owner" "display: default ${opts[0]}" lua "hyprctl reload" || rc=$?
  else
    structured_run display desktop_mon_add_build "$file" "$owner" "$subject" lua "hyprctl reload" || rc=$?
  fi
  export STRUCTURED_REDACT=0
  return "$rc"
}

# cmd_reconcile — portable software reconciliation. Preview names the source
# machine, the missing official and AUR packages separately, and the exact
# official install command for the selection. Installs only named packages,
# never removes, and writes nothing to the repo, so no lock is taken.
cmd_reconcile() {
  load_core
  local sub=""
  case "${1:-}" in
    install) sub="install"; shift || true ;;
    --from|--from=*|--json) ;;
    "") ;;
    -h|--help) ;;
    *) fail "usage: replicant reconcile [--from <machine>] [--json] | reconcile install <pkg...> [--aur] [--apply] (try --help)" ;;
  esac
  if [[ "$sub" == install ]]; then
    local kind=official
    local -a rest=()
    local a
    for a in "$@"; do
      [[ "$a" == "--aur" ]] && { kind=aur; continue; }
      rest+=("$a")
    done
    reconcile_install "$kind" "${rest[@]}"
    return $?
  fi
  reconcile_preview "$@"
}

cmd_doctor() {
  load_core
  local problems=0
  chk_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
  chk_warn() { printf '  \033[33m!\033[0m %s\n' "$1"; problems=$((problems+1)); }
  chk_bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; problems=$((problems+1)); }

  echo "Tools"
  for c in git jq gh; do
    command -v "$c" >/dev/null 2>&1 && chk_ok "$c installed" || chk_bad "$c missing — omarchy pkg add ${c/gh/github-cli}"
  done
  if command -v age >/dev/null 2>&1; then
    chk_ok "age installed"
  else
    chk_bad "age missing — omarchy pkg add age"
  fi
  if command -v age-keygen >/dev/null 2>&1; then
    local probe_dir
    probe_dir=$(mktemp -d 2>/dev/null || echo "")
    if [[ -n "$probe_dir" ]] && ( umask 077; age-keygen -pq -o "$probe_dir/key" >/dev/null 2>&1 ) && grep -q '^# public key: age1pq1' "$probe_dir/key" 2>/dev/null; then
      chk_ok "age-keygen makes post-quantum keys"
    else
      chk_warn "age-keygen here cannot make post-quantum keys — upgrade age past 1.3 (omarchy pkg add age), then retry"
    fi
    [[ -n "$probe_dir" ]] && rm -rf -- "$probe_dir" 2>/dev/null || true
  else
    chk_warn "age-keygen missing — omarchy pkg add age"
  fi

  echo "Plugins"
  # The inventory is what rebuilds this machine's shell elsewhere, and a plugin
  # with no git origin cannot be rebuilt by anything. shell.json still lists it
  # in the bar layout, so the other machine would come back with a hole where
  # that widget was — worth saying here rather than discovering it there.
  local lo n_lo
  lo=$(local_only_plugins 2>/dev/null || true)
  n_lo=$(printf '%s' "$lo" | grep -c . || true)
  # An origin that is a filesystem path is a real answer here but may well not
  # exist on the machine doing the restoring, so it is called out separately
  # rather than counted as fine.
  local inv_path n_pathy
  inv_path="$STATE_DIR/omarchy-plugins.txt"
  n_pathy=$(awk -F'\t' '!/^#/ && NF>=3 && $3 ~ /^\// {n++} END{print n+0}' "$inv_path" 2>/dev/null || echo 0)
  (( n_pathy > 0 )) && chk_warn "$(plural "$n_pathy" "plugin origin") are local paths — they may not exist on your other machine"
  if (( n_lo == 0 )); then
    chk_ok "every installed plugin can be reinstalled from its origin"
  else
    chk_warn "$(plural "$n_lo" plugin) exist only on this machine and cannot be reinstalled:"
    printf '%s\n' "$lo" | sed 's/^/      /' >&2
    printf '      push them to a git remote, or they are lost with this machine\n' >&2
  fi

  local pp n_pp
  pp=$(missing_plugins 2>/dev/null || true)
  n_pp=$(printf '%s' "$pp" | grep -c . || true)
  if (( n_pp > 0 )); then
    chk_warn "$(plural "$n_pp" plugin) recorded but not installed here — restore does not fetch these on its own:"
    printf '%s\n' "$pp" | awk -F'\t' '{print "      replicant install-plugin " $1}' >&2
  fi

  # A clone HAS an origin, so the check above calls it fine — and it is, about
  # the plugin. It is not fine about the work in it: `omarchy plugin clone`
  # reinstalls the BUILT-IN, and a clone exists because somebody edited it.
  # Reinstalling gives back the stock version and the edits are gone. The
  # inventory says so in its own header; nothing said it to the person.
  local cl n_cl cl_id cl_dir cl_deriv untracked_clones="" derived_clones=""
  cl=$(bash "$CORE" cloned-plugins 2>/dev/null || true)
  n_cl=$(printf '%s' "$cl" | grep -c . || true)
  if (( n_cl > 0 )); then
    while IFS=$'\t' read -r cl_id cl_dir cl_deriv; do
      [[ -n "$cl_id" ]] || continue
      # Regenerated by a pack that is still installed: nothing to back up, and
      # backing it up would freeze what the deriver exists to keep current.
      if [[ -n "${cl_deriv:-}" ]] && command -v "$cl_deriv" >/dev/null 2>&1; then
        derived_clones+="      $cl_id  ·  regenerated by $cl_deriv"$'\n'
        continue
      fi
      # Tracked is not saved. Saying "your edits come back too" the moment an
      # entry is added, before anything has been copied in, is this plugin
      # promising a recovery the repo cannot perform — the exact shape of every
      # other bug found this week. Ask the repo, not the list.
      if is_tracked_path "$cl_dir/" 2>/dev/null; then
        [[ -d "$(bash "$CORE" repo-path "omarchy/plugins/${cl_dir##*/}/" 2>/dev/null)" ]] && continue
        untracked_clones+="      $cl_id  →  tracked but not saved yet: replicant save --auto"$'\n'
        continue
      fi
      untracked_clones+="      $cl_id  →  replicant track ${cl_dir/#$HOME/\~}/"$'\n'
    done <<< "$cl"
  fi
  if [[ -n "$untracked_clones" ]]; then
    chk_warn "$(plural "$(printf '%s' "$untracked_clones" | grep -c .)" "cloned plugin") cannot be recovered yet:"
    printf '%s' "$untracked_clones" >&2
  elif (( n_cl > 0 )); then
    chk_ok "$(plural "$n_cl" "cloned plugin") covered"
  fi
  if [[ -n "$derived_clones" ]]; then
    printf '%s' "$derived_clones" >&2
  fi

  # An origin says where the plugin came from, not that the work in it is
  # there. An edit made in place, or a commit never pushed, exists only in this
  # checkout, and install-plugin on the other machine brings back the origin's
  # code without it.
  local ed e_id e_dir e_dirty e_ahead e_what edited_lines=""
  ed=$(edited_plugins 2>/dev/null || true)
  while IFS=$'\t' read -r e_id e_dir e_dirty e_ahead; do
    [[ -n "$e_id" ]] || continue
    e_what=""
    (( e_dirty > 0 )) && e_what="$(plural "$e_dirty" "uncommitted change")"
    (( e_ahead > 0 )) && e_what="${e_what:+$e_what, }$(plural "$e_ahead" "commit") not pushed"
    edited_lines+="      $e_id  ·  $e_what  →  push it, or: replicant track ${e_dir/#$HOME/\~}/"$'\n'
  done <<< "$ed"
  if [[ -n "$edited_lines" ]]; then
    chk_warn "$(plural "$(printf '%s' "$edited_lines" | grep -c .)" plugin) with work that exists only in this checkout — reinstalling brings back the origin's code without it:"
    printf '%s' "$edited_lines" >&2
  fi

  # Two machines, one repo, upgraded on different days. Until every machine runs
  # 0.7.0 or newer, the older one still prunes what this one tracks — it has no
  # guard to check, because the guard did not exist when it shipped.
  local seen_ver run_ver
  seen_ver=$(repo_written_by 2>/dev/null || true)
  run_ver=$(running_version 2>/dev/null || echo "?")
  if [[ -n "$seen_ver" ]] && version_lt "$run_ver" "$seen_ver"; then
    chk_warn "this repo was last written by Replicant $seen_ver and this machine has $run_ver"
    printf '    saves from here will not prune, so nothing is lost — but upgrade to see everything\n' >&2
  else
    chk_ok "this machine ($run_ver) is not behind the repo${seen_ver:+ ($seen_ver)}"
  fi

  echo "Themes"
  # The same question, for the thing a person actually looks at. A theme is a
  # git clone, so the inventory records its URL and `omarchy theme install`
  # rebuilds it — but a theme written by hand has no URL, and nothing puts it
  # back unless its directory is in the tracked list.
  local lt n_lt n_inv
  lt=$(local_only_themes 2>/dev/null || true)
  n_lt=$(printf '%s' "$lt" | grep -c . || true)
  n_inv=$(awk -F'\t' '!/^#/ && NF>=2 && $2 != "-" {n++} END{print n+0}' "$STATE_DIR/omarchy-themes.txt" 2>/dev/null || echo 0)
  chk_ok "$(plural "$n_inv" "user theme") recorded with an origin — install one with 'replicant install-theme'"
  local pt n_pt
  pt=$(missing_themes 2>/dev/null || true)
  n_pt=$(printf '%s' "$pt" | grep -c . || true)
  if (( n_pt > 0 )); then
    chk_warn "$(plural "$n_pt" theme) recorded but not installed here — restore does not fetch these on its own:"
    printf '%s\n' "$pt" | awk -F'\t' '{print "      replicant install-theme " $1}' >&2
  fi
  if (( n_lt > 0 )); then
    chk_warn "$(plural "$n_lt" theme) have no origin and are not tracked either:"
    printf '%s\n' "$lt" | sed 's/^/      /' >&2
    printf '      track the directory to back one up: replicant track ~/.config/omarchy/themes/<name>\n' >&2
  fi

  echo "Hyprland"
  # Every module hyprland.lua loads is tracked with it, found by reading its
  # require lines. A module that exists nowhere cannot be saved, and Hyprland
  # reports it as an error on every reload.
  local hu n_hu n_hm=0 hentry hrel hunsaved=""
  hu=$(unresolved_hypr_modules 2>/dev/null || true)
  n_hu=$(printf '%s' "$hu" | grep -c . || true)
  for hentry in ${AUTO_MANIFEST[@]+"${AUTO_MANIFEST[@]}"}; do
    hrel="${hentry##*:}"
    [[ "$hrel" == hypr/* ]] || continue
    n_hm=$((n_hm + 1))
    # Tracked is not saved: the first version said "saved with it" about a
    # module no save had copied yet. The repo is asked, not the list.
    [[ -f "$(repo_copy_for_rel "$hrel")" ]] || hunsaved+="      $hrel"$'\n'
  done
  if (( n_hu > 0 )); then
    chk_bad "your Hyprland config loads $(plural "$n_hu" module) that do not exist here:"
    printf '%s\n' "$hu" | sed 's/^/      /' >&2
    printf '      create the file, or remove its require line from ~/.config/hypr/\n' >&2
  fi
  if [[ -n "$hunsaved" ]]; then
    chk_warn "$(plural "$(printf '%s' "$hunsaved" | grep -c .)" module) that hyprland.lua loads tracked, not saved yet — replicant save --auto:"
    printf '%s' "$hunsaved" >&2
  elif (( n_hm > 0 )); then
    chk_ok "$(plural "$n_hm" "extra module") that hyprland.lua loads saved with it"
  elif (( n_hu == 0 )); then
    chk_ok "every module hyprland.lua loads is tracked"
  fi

  echo "GitHub"
  # Every network call below has a timeout: doctor runs in the panel's
  # foreground, and a hung DNS must not freeze it. `gh` sets no timeout itself.
  if command -v gh >/dev/null 2>&1 && timeout 10 gh auth status >/dev/null 2>&1; then
    chk_ok "logged in as $(timeout 10 gh api user --jq .login 2>/dev/null || echo '?')"
  else
    chk_warn "not logged in — run: replicant login"
  fi

  echo "Keys"
  # Version 1 repos keep secrets in plaintext and have no vault: nothing to
  # check here beyond the Tools section above. Version 2 reports the exact
  # remediation, the same string the failing save prints.
  if [[ -d "$REPO_DIR/.git" ]] && repo_has_vault 2>/dev/null; then
    local key_out key_rc
    if key_out=$(bash "$CORE" key status 2>&1); then key_rc=0; else key_rc=$?; fi
    if (( key_rc == 0 )); then
      chk_ok "secret key ready — $(printf '%s' "$key_out" | sed -e 's/^key: //')"
    else
      chk_warn "secret key needs attention — $(printf '%s' "$key_out" | head -n1 | sed -e 's/^key: //;s/^replicant: //')"
      printf '    run: %s\n' "$(key_remediation 2>/dev/null || echo 'replicant key status')" >&2
    fi
    local n_locked
    n_locked=$(bash "$CORE" status --json --no-fetch 2>/dev/null | jq -r '.locked // 0' 2>/dev/null || true)
    [[ -z "$n_locked" ]] && n_locked=0
    if [[ "$n_locked" =~ ^[0-9]+$ ]] && (( n_locked > 0 )); then
      chk_warn "$(plural "$n_locked" secret) locked — import the key, then retry"
    fi
  else
    chk_ok "no encrypted vault in this repo — nothing to unlock"
  fi

  echo "Repo"
  if [[ -d "$REPO_DIR/.git" ]]; then
    chk_ok "local repo at $REPO_DIR"
    local url; url=$(repo_remote_url || echo "")
    if [[ -z "$url" ]]; then
      chk_warn "no remote — nothing is backed up off this machine"
    else
      chk_ok "remote $url"
      local slug vis
      slug=$(printf '%s' "$url" | sed -E 's#(https://github.com/|git@github.com:)##; s/\.git$//')
      vis=$(timeout 10 gh repo view "$slug" --json visibility --jq .visibility 2>/dev/null || echo "")
      case "$vis" in
        PRIVATE) chk_ok "remote is PRIVATE" ;;
        PUBLIC)  chk_bad "remote is PUBLIC and this repo holds secrets — gh repo edit $slug --visibility private" ;;
        *)       chk_warn "could not read the remote's visibility (offline, or no access)" ;;
      esac
    fi
    [[ "$(repo_hooks_path)" == ".githooks" ]] \
      && chk_ok "pre-commit secret scan enabled" \
      || chk_warn "secret-scan hook not enabled — run: replicant save --auto"
    local perm; perm=$(stat -c '%a' "$SECRETS_DIR" 2>/dev/null || echo "")
    [[ -z "$perm" ]] && chk_warn "no secrets/ directory yet" || {
      [[ "$perm" == "700" ]] && chk_ok "secrets/ is 700" || chk_bad "secrets/ is $perm, expected 700 — chmod 700 $SECRETS_DIR"
    }
  else
    chk_warn "no local repo yet — run: replicant create --push"
  fi

  echo "Transactions"
  local tx_lines n_tx
  tx_lines=$(bash "$CORE" tx-list 2>/dev/null || true)
  n_tx=$(printf '%s' "$tx_lines" | grep -c . || true)
  if (( n_tx == 0 )); then
    chk_ok "no abandoned save transactions"
  else
    local tx_uuid tx_stage tx_scope
    while IFS=$'\t' read -r tx_uuid tx_stage _base tx_scope _cand _push _msg; do
      [[ -n "$tx_uuid" ]] || continue
      if [[ "$tx_stage" == "committed" || "$tx_stage" == "fast-forwarded" ]]; then
        chk_warn "transaction $tx_uuid committed ($tx_scope) but not in the active repo — resume it: replicant tx resume $tx_uuid"
      else
        chk_warn "transaction $tx_uuid abandoned before commit ($tx_stage) — discard it: replicant tx discard $tx_uuid"
      fi
    done <<< "$tx_lines"
  fi

  echo "Command line"
  if [[ -L "$LINK_PATH" && "$(readlink -f "$LINK_PATH" 2>/dev/null)" == "$(readlink -f "$SELF_BIN")" ]]; then
    chk_ok "replicant is on your PATH ($LINK_PATH)"
  else
    printf '  \033[33m·\033[0m not on your PATH — the panel does not need it; run '"'"'replicant link'"'"' to use it in a terminal\n'
  fi

  echo "Tracked files"
  local entry src missing=0 total=0
  for entry in "${TRACKED[@]}"; do
    src="${entry%%:*}"; total=$((total+1))
    # -e and the trailing slash stripped: a tracked directory is present too,
    # and -f reported every one of them as missing.
    [[ -e "${src%/}" ]] || missing=$((missing+1))
  done
  chk_ok "$((total - missing)) of $total tracked files present on this machine"
  (( missing > 0 )) && printf '    (%d not on this machine — normal on a fresh install)\n' "$missing"
  local n_user n_sugg
  n_user=$(( ${#USER_MANIFEST[@]} + ${#USER_SECRETS[@]} ))
  chk_ok "$n_user of them are yours — the rest ship with the plugin"
  n_sugg=$(core_suggest 2>/dev/null | grep -c . || true)
  (( n_sugg > 0 )) && chk_warn "$(plural "$n_sugg" "more file") here are not tracked — see 'replicant suggest'"

  echo "Settings"
  local unavailable=0 implicit=0 sid fb
  for entry in "${SETTINGS[@]}"; do
    sid=$(setting_field "$entry" 1); fb=$(setting_field "$entry" 13)
    get_setting_value "$sid" >/dev/null 2>&1 && continue
    if [[ -n "$fb" ]]; then implicit=$((implicit+1)); else unavailable=$((unavailable+1)); fi
  done
  chk_ok "$(( ${#SETTINGS[@]} - unavailable )) of ${#SETTINGS[@]} settings editable"
  (( implicit > 0 )) && printf '    (%d still at the shell'"'"'s built-in default; changing one writes the key)\n' "$implicit"
  (( unavailable > 0 )) && printf '    (%d absent from this machine'"'"'s configs — greyed out in the panel)\n' "$unavailable"
  true

  echo
  if (( problems == 0 )); then ok "No problems found."; else warn "$(plural "$problems" thing) to look at above."; fi
}

# ── PATH convenience, opt-in and reversible ─────────────────────────────────
# The panel never needs this: it calls the CLI by absolute path, resolved from
# its own location. `omarchy plugin add` runs no install hook, so a plugin that
# wanted to be on PATH would have to write outside its own directory behind the
# user's back — and leave a dangling symlink when the plugin is removed. So
# it's a command instead: explicit, and `unlink` puts it back exactly.
LINK_PATH="$HOME/.local/bin/replicant"
SELF_BIN="$PLUGIN_DIR/bin/replicant"

cmd_link() {
  mkdir -p "$(dirname "$LINK_PATH")"
  if [[ -L "$LINK_PATH" ]]; then
    local current; current=$(readlink -f "$LINK_PATH" 2>/dev/null || echo "")
    if [[ "$current" == "$(readlink -f "$SELF_BIN")" ]]; then ok "already linked: $LINK_PATH"; return 0; fi
    warn "$LINK_PATH points at $current — replacing it"
  elif [[ -e "$LINK_PATH" ]]; then
    fail "$LINK_PATH already exists and is not a symlink — move it aside first"
  fi
  ln -sfn "$SELF_BIN" "$LINK_PATH"
  ok "linked $LINK_PATH -> $SELF_BIN"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) : ;;
    *) warn "~/.local/bin is not on your PATH — add it to use 'replicant' by name" ;;
  esac
}

cmd_unlink() {
  if [[ -L "$LINK_PATH" ]]; then
    rm -f "$LINK_PATH"; ok "removed $LINK_PATH"
  elif [[ -e "$LINK_PATH" ]]; then
    warn "$LINK_PATH is not a symlink — leaving it alone"
  else
    ok "nothing to unlink"
  fi
}

# ── purge — leave the machine as if the plugin had never run ────────────────
# Everything this plugin creates outside its own directory, in one place, so a
# user removing it is never left guessing what is still on disk. Dry-run by
# default like every other destructive command here.
# The safety net, made reachable. Every write this plugin makes to the real
# machine leaves the previous version as <file>.bak.<epoch>, and until now the
# only code that could find one was `purge`, which removes the whole plugin.
# Eleven of them were sitting on the machine this was written on: unnamed,
# unreachable, and therefore a mess rather than a net.
cmd_backups() {
  ensure_core
  local DRY=1 PRUNE=0 arg
  for arg in "$@"; do
    case "$arg" in
      --prune) PRUNE=1 ;;
      --apply) DRY=0 ;;
      --dry-run) DRY=1 ;;
    esac
  done
  local -a paths=()
  local rel src b epoch state n=0
  while IFS=$'\t' read -r rel src b epoch state; do
    [[ -n "$rel" ]] || continue
    paths+=("$b")
    n=$((n + 1))
    if (( ! PRUNE )); then
      local when; when=$(date -d "@$epoch" '+%d %b %H:%M' 2>/dev/null || echo "$epoch")
      # "same" is the useful column: a backup byte-identical to the live file is
      # a copy of what you already have, and the one it is always safe to drop.
      printf '  %-28s %s  %-8s %s\n' "$rel" "$when" "$state" "${b/#$HOME/\~}"
    fi
  done < <(bash "$CORE" backups)

  if (( n == 0 )); then ok "no .bak.<epoch> backups on this machine"; return 0; fi

  if (( ! PRUNE )); then
    echo >&2
    info "$(plural "$n" backup) · 'undo <id>' puts the newest one back · 'backups --prune --apply' removes them all"
    return 0
  fi
  echo "── would remove ──" >&2
  printf '  · %s\n' "${paths[@]/#$HOME/\~}" >&2
  if (( DRY )); then
    echo >&2; skip "dry-run — nothing was touched. Repeat with --apply"
    return 0
  fi
  rm -rf -- "${paths[@]}"
  ok "removed $(plural "$n" backup)"
}

cmd_undo() {
  ensure_core
  local id="" DRY=1 arg
  for arg in "$@"; do
    case "$arg" in
      --apply) DRY=0 ;;
      --dry-run) DRY=1 ;;
      -y|--yes) fail "undo: --yes is not supported; use --apply" ;;
      -*) fail "unknown option: $arg" ;;
      *) [[ -z "$id" ]] && id="$arg" || fail "undo: too many ids: $arg" ;;
    esac
  done
  [[ -n "$id" ]] || fail "undo <id> — see 'replicant backups'"
  # DRY reaches the core as an argument, not as an env prefix on `bash -c`.
  # The prefix form (`DRY=$DRY bash -c '... DRY='"$DRY"' ...'`) set the variable
  # twice by two different mechanisms and shellcheck was right to call it out:
  # the prefix is seen only by the forked shell, which then immediately
  # overwrote it with a spliced literal. One way in is enough.
  bash -c 'DRY="$3"; source "$1" || exit $?; core_undo "$2"' \
    _ "$CORE" "$id" "$DRY" || fail "nothing undone"
  if (( DRY )); then
    echo >&2; skip "dry-run — nothing was touched. Repeat with --apply"
  fi
}

cmd_purge() {
  local DRY=1 YES=0 KEEP_REPO=1
  while (( $# )); do case "$1" in
    --apply) DRY=0; shift;;
    --dry-run) DRY=1; shift;;
    --yes|-y) YES=1; shift;;
    --repo) KEEP_REPO=0; shift;;
    *) fail "unknown option: $1";;
  esac; done

  local -a targets=()
  local -a recovery=()
  [[ -L "$LINK_PATH" ]] && targets+=("$LINK_PATH")
  [[ -f "$REPLICANT_HOME/.replicant.lock" ]] && targets+=("$REPLICANT_HOME/.replicant.lock")
  [[ -f "$REPLICANT_HOME/.last-fetch" ]] && targets+=("$REPLICANT_HOME/.last-fetch")
  # Written by `pull`: which entries another machine has a newer copy of. Named
  # here literally rather than through the core's $INCOMING_FILE, because purge
  # runs in the CLI's own shell and an unbound variable here kills the one
  # command whose job is to leave nothing behind.
  [[ -f "$REPLICANT_HOME/incoming" ]] && targets+=("$REPLICANT_HOME/incoming")
  # Left by a root-owned write that nothing could ask for root for. It is the
  # file that the printed `sudo install` command names.
  [[ -d "$REPLICANT_HOME/staged" ]] && targets+=("$REPLICANT_HOME/staged")
  # The list of backups that setting edits made, which is what they prune.
  [[ -f "$REPLICANT_HOME/setting-backups" ]] && targets+=("$REPLICANT_HOME/setting-backups")
  # The marketplace catalog, which install-plugin caches for an hour.
  [[ -f "$REPLICANT_HOME/catalog.json" ]] && targets+=("$REPLICANT_HOME/catalog.json")
  # The brief-status cache: file identity and counts, no secret content.
  [[ -d "$REPLICANT_HOME/cache" ]] && targets+=("$REPLICANT_HOME/cache")
  # The rotation recovery record. Kept with the keys by default: while it
  # exists, a previous rotation never finished reconciling. Named here
  # literally like incoming above, for the same unbound-variable reason.
  [[ -f "$REPLICANT_HOME/key-rotation.json" ]] && recovery+=("$REPLICANT_HOME/key-rotation.json")
  # Abandoned save transactions (worktree plus meta.json journal). A finished
  # save removes its own; only interrupted ones are ever still here.
  [[ -d "$REPLICANT_HOME/transactions" ]] && targets+=("$REPLICANT_HOME/transactions")
  [[ -d "$REPO_DIR" ]] && recovery+=("$REPO_DIR")
  [[ -d "$REPLICANT_HOME/keys" ]] && recovery+=("$REPLICANT_HOME/keys")
  if (( ! KEEP_REPO )); then
    [[ -d "$REPLICANT_HOME" ]] && targets+=("$REPLICANT_HOME")
  fi

  # .bak.<epoch> copies this plugin left behind next to the configs it edited
  local -a backups=() orphans=()
  local _rel _src b _epoch _state
  load_core
  # Through list_backups, not a second glob of its own. The trailing-slash bug
  # hard rule 8 exists for lived here first (globbing "$src".bak.* on a tracked
  # directory looks INSIDE the directory and finds nothing), and having two
  # copies of that glob is how purge and `backups` would come to disagree about
  # what is on the machine. Orphans (backups beside files nothing tracks
  # anymore) come from list_orphan_backups and join the same list, deduplicated.
  while IFS=$'\t' read -r _rel _src b _epoch _state; do
    [[ -n "$b" ]] && backups+=("$b")
  done < <(bash "$CORE" backups)
  while IFS= read -r b; do
    [[ -n "$b" ]] && orphans+=("$b")
  done < <(bash "$CORE" backups-orphan)
  if (( ${#orphans[@]} > 0 )); then
    local -A seen=()
    for b in "${backups[@]}"; do seen["$b"]=1; done
    for b in "${orphans[@]}"; do
      [[ -n "${seen[$b]:-}" ]] || { backups+=("$b"); seen["$b"]=1; }
    done
  fi

  if (( ${#targets[@]} == 0 && ${#backups[@]} == 0 )); then
    ok "nothing to purge — this machine is already clean"
    if (( KEEP_REPO )) && [[ -d "$REPLICANT_HOME" ]]; then
      info "your backup repo is still at $REPLICANT_HOME (use --repo to remove it too)"
    fi
    return 0
  fi

  echo "── would remove ──" >&2
  local t
  for t in "${targets[@]}"; do echo "  · ${t/#$HOME/\~}" >&2; done
  if (( ${#backups[@]} > 0 )); then
    if (( ${#orphans[@]} > 0 )); then
      echo "  · $(plural "${#backups[@]}" ".bak.<epoch> backup") next to your configs ($(plural "${#orphans[@]}" "orphaned backup"))" >&2
    else
      echo "  · $(plural "${#backups[@]}" ".bak.<epoch> backup") next to your configs" >&2
    fi
  fi
  if (( ${#recovery[@]} > 0 )); then
    if (( KEEP_REPO )); then
      echo "── would keep for recovery ──" >&2
      for t in "${recovery[@]}"; do echo "  · ${t/#$HOME/\~}" >&2; done
      echo >&2; info "pass --repo to remove the repository and keys"
    else
      echo "── recovery data included by --repo ──" >&2
      for t in "${recovery[@]}"; do echo "  · ${t/#$HOME/\~}" >&2; done
    fi
  elif (( KEEP_REPO )) && [[ -d "$REPLICANT_HOME" ]]; then
    echo >&2; info "keeping your backup repo at $REPLICANT_HOME — pass --repo to remove that too"
  fi
  if (( ! KEEP_REPO )) && [[ -f "$REPLICANT_HOME/keys/identity.txt" ]]; then
    warn "this also removes your secret key — export it first (key export <dest>) unless another machine holds it"
  fi

  if (( DRY )); then echo >&2; skip "dry-run — nothing was touched. Repeat with --apply" >&2; return 0; fi
  if (( ! YES )); then
    read -rp "Remove the above? Your GitHub repo is not touched. [y/N] " resp </dev/tty 2>&1 || resp=""
    [[ $resp == [yY] ]] || { warn "purge cancelled"; return 0; }
  fi
  for t in "${targets[@]}"; do rm -rf -- "$t" && ok "removed ${t/#$HOME/\~}"; done
  # -rf, not -f: a restored directory's backup is a whole tree, and rm -f on a
  # directory silently does nothing — purge listed it and then left it there.
  (( ${#backups[@]} > 0 )) && { rm -rf -- "${backups[@]}"; ok "removed $(plural "${#backups[@]}" backup)"; }
  ok "purged. Remove the plugin itself with: omarchy plugin remove $PLUGIN_ID"
}

usage() {
  cat <<USAGE
replicant [--progress-json] — back up, restore and replicate your Omarchy setup

  The panel in your bar does all of this without a terminal. These are here for
  scripts, and for the days you would rather type. With --progress-json the
  command streams JSON Lines progress events on stderr.

First machine
  create [name] [--push]      Make the PRIVATE GitHub repo and push this machine into it
  setup-status --json         Show GitHub API and SSH transport setup without credentials
  login                       gh auth, if you are not logged in yet
  init                        Prepare the local repo without touching GitHub

Every day
  save [--all] [-m "why"] [--auto]   Copy everything in, one commit, push
             [--id <id> ...]         (--no-push to hold; --auto writes the
             [--inventory]           subject from what changed)
  changes                     Review what a save would commit — read-only
  tx list|resume|discard      Recover an abandoned save transaction
  status [--json] [--brief] [--defer-settings]   What changed, what is pushed, what is not
  diff [id]                   Pending changes, or what changed in one file
  push                        Send the commits you already have, and nothing else
  pull                        Bring down what another machine saved

What gets backed up
  suggest [--json]            Config on this machine that nothing is backing up yet
  track <path> [name] [--secret]   Add a file or directory to YOUR list
  untrack <id>                Drop one of your own entries, and its copy
  forget <id>                 A file you deleted: its copy leaves the repo too
  scope <id> shared|profile|off    Who syncs this file
  policy set --scope <scope> -- <id...>  Set one scope for several entries in one commit
  bulk save|scope|track|convert-secret|untrack [options] -- <id...>
                              Apply one validated multi-entry operation atomically
  profile [name]              Which profile this machine is in
  save-file <id> [-m]         Commit and push just that one file
  path <id>  ·  edit <id>     Where a tracked id really lives; open it in your editor

Settings
  settings [--json]           Every editable setting and its current value
  get <id>  ·  set <id> <v>   Read or write one     (always in the stored unit, e.g. seconds)
  revert <id> [--to default|repo]   Put one setting back
  apply <shell|hyprland|terminal> [--apply]   Run what a settings change needs
  shortcuts [--json]          Your keybinding overrides, and what is bound now

Structured editors            (preview first; --apply writes and saves)
  shortcut list [--json]      Your keybindings, managed and your own
  shortcut add <keys> <command> [--desc text] [--apply]
  shortcut disable <keys> [--apply]    Silence a binding without deleting it
  shortcut restore <keys> [--apply]    Bring back a silenced binding
  shortcut remove <keys> [--apply]     Delete one of your Replicant bindings
  compose list [--json]       Your compose sequences, managed and your own
  compose add '<seq>' '<result>' [--apply]
  compose remove '<seq>' [--apply]
  bar-layout list [--json]     Widgets per bar section, in order
  bar-layout move <widget> --section <s> [--before x|--after x|--index n] [--apply]
  bar-layout enable <id> --section <s> [--apply]
  bar-layout disable <widget> [--apply]
  bar-layout spacer --section <s> [--size n] [--apply]

Desktop editors               (preview first; --apply writes and saves)
  workspace list [--json]     Workspaces: structure shared, monitors per profile
  workspace define <n> [--name X] [--layout L] [--persistent on|off] [--apply]
  workspace undefine <n> [--apply]
  workspace count <n> [--apply]   Keep workspaces 1..N alive when empty
  workspace app-add <class> <n> [--apply]
  workspace app-remove <class> [--apply]
  workspace assign <n> <monitor> [--default] [--apply]
  workspace unassign <n> [--apply]
  display list [--json]       Monitors: entries, connection, offered modes
  display set <monitor> [--mode WxH@R] [--scale S] [--rotation 0-7]
    [--position XxY|auto] [--mirror M] [--vrr 0-2] [--hdr|--no-hdr] [--apply]
  display enable|disable <monitor> [--apply]
  display remove <monitor> [--apply]
  display default <monitor> [--apply]   Workspace 1 opens here by default

Software you chose               (preview first; --apply installs, never removes)
  reconcile [--from <machine>] [--json]   What another machine has that this one lacks
  reconcile install <pkg...> [--aur] [--apply]   Install named missing packages

Secret key                   (one shared age identity behind encrypted secrets)
  key init                    Create it on this machine, and record the recipient
  key export [--force] <dest>  Back it up outside the repo (absolute path)
  key import <src>            Adopt it on a new machine, before saving secrets
  key status                  Whether this machine can read the vault
  key rotate                  Replace it, re-encrypting every secret

Putting things back            (dry run by default; .bak.<epoch> kept for everything)
  restore [--apply] [--all] [--only <area>] [--yes]
                              Everything, or one area, from the repo
  restore-file <id>           One file or directory back from the repo
  reset <id>                  One file back to Omarchy's default
  reset-all [--apply] [--yes] Everything with a known default back to factory
  deleted                     Copies that left the repo, by the commit that removed them
  recover <sha> [--apply]     Bring back what one commit deleted, onto this machine too

Third-party code               (no dry run, no backup; fetches the moment you run it)
  install-theme <name>        Install one theme from your inventory — never automatic
  install-plugin <id> --check  Resolve and show a remote revision, without fetching code
  install-plugin <id> --revision <sha> --yes
                              Install only the selected revision — never automatic

Second machine
  clone <url>                 Point this machine at the repo you already have

The plugin itself
  update-check [--fetch]      Whether a newer Replicant is at its origin    (--json)
  update [--yes] [--restart]  Install it with omarchy plugin update

Housekeeping
  backups [--prune] [--apply] Every .bak.<epoch> this plugin left, and when
  undo <id> [--apply]         Put the newest .bak.<epoch> back for one file
  doctor                      Auth, remote privacy, hooks, permissions, version skew
  log [-n N] [--json]         Recent saves
  link | unlink               Add or remove replicant on your PATH
  purge [--apply] [--repo]    Remove what this plugin left on this machine

Two ways back, and they are not the same thing
  reset-all --apply           everything -> Omarchy's defaults (factory)
  restore --apply --all       everything -> what is saved in your repo
USAGE
}

# `--help` is a question, never an instruction.
#
# Every command dispatched before anything looked for the flag, so it arrived
# as an ordinary argument and the command ran: `unlink --help` removed the
# symlink from PATH, `link --help` put it back somewhere else, `pull --help`
# fetched, `init --help` wrote the whole repo layout, and `push --help`
# committed a file with "--help" as the subject and pushed it to GitHub. Every
# one of those exited 0 and looked like help had been printed. Asking a command
# what it does must never be the same as doing it.
#
# Only the FIRST argument is inspected, so a message that happens to be "-h"
# (`save -m -h`) is still a message and not a help request.
declare -A HELP=(
  [backups]="backups [--prune] [--apply]  —  the safety net, listed

Every write this plugin makes to your machine keeps what it overwrote as
<file>.bak.<epoch>. This is the only way to see them.

The 'same' column means the backup is byte-identical to the file that is
there now: a copy of what you already have, and always safe to drop.

  backups                    list them, newest first
  backups --prune            show what removing them all would remove
  backups --prune --apply    remove them
  undo <id>                  put the newest one back for one file"
  [undo]="undo <id> [--apply]  —  that restore was wrong, give me the previous version

Puts the newest <file>.bak.<epoch> back, and takes the version it replaces
as the new backup. A swap, so undo can itself be undone and the pile of
backups does not grow every time you use it.

Dry-run by default, like everything here that writes.

  replicant backups          which ids have one
  replicant undo hypr/input.lua
  replicant undo hypr/input.lua --apply"
  [init]="init
  Prepare the local repo without touching GitHub. Safe to re-run: it creates the
  layout, the hooks and the .gitignore."
  [login]="login
  Log in to GitHub with gh, if you are not logged in already. Nothing else."
  [create]="create [name] [--push]
  Make the PRIVATE GitHub repo for YOUR data and push this machine into it.
  Add --transport https or --transport ssh to choose the Git URL.
  Defaults to <hostname>-replicant. Always private. Asks; run it in a terminal."
  [setup-status]="setup-status --json
  Report GitHub API authentication and SSH transport readiness without exposing credentials."
  [changes]="changes
  Review what a save would commit: pending repo paths plus staged stats.
  Read-only: it never writes to the repo. Save with save --all -m, or
  save --id <id> -m for one entry."
  [tx]="tx list|resume <uuid>|discard <uuid> [--force]
  Recover an abandoned save transaction under transactions/. list shows the
  journal stage. resume fast-forwards a committed one and pushes. discard
  drops a pre-commit one; a committed one needs --force."
  [save]="save [--all] [--id <id> ...] [--inventory] [-m \"why\"] [--auto] [--no-push]
  Copy everything in through one transaction: snapshot, one commit, push.
  --all saves everything (config, secrets, inventory) in one commit. --id
  saves exactly the named entries. --inventory saves only this machine's
  inventory. With -m, one commit carrying your reason. With --auto, a subject
  derived from the paths that changed (what the panel's Save button uses).
  With neither, the inventory is committed when it moved and anything else is
  left for a reasoned commit by hand. --no-push holds it all locally."
  [status]="status [--json] [--brief] [--defer-settings] [--fetch|--no-fetch]
  What changed, what is saved, what is still to push. --json is what the panel
  reads. --defer-settings answers every row with an empty settings array and a
  settings_deferred marker; the Settings tab then loads 'settings --json' on
  demand. Read-only: it never writes to the repo."
  [get]="get <setting-id>
  Print one setting's current value, in the unit it is stored in."
  [set]="set <setting-id> <value>
  Write one setting. Always in the STORED unit — 'set idle.lock 600' is seconds,
  even though the panel shows you minutes."
  [diff]="diff  ·  diff <id>
  With no id: everything waiting to be saved. With an id: what changed in that
  one file. The contents of a tracked secret are never printed — only whether
  it differs."
  [edit]="edit <id> [--wait]
  Open that tracked file in your editor. Directories open at their top."
  [path]="path <id>
  Print where a tracked id really lives on this machine."
  [save-file]="save-file <id> [-m \"why\"]
  Commit and push just that one file, staging nothing else.
  This is 'save --id <id>' with a default subject."
  [log]="log [-n N] [--json]
  Recent saves. Runs of identical subjects are collapsed with a count."
  [settings]="settings [--json]
  Every editable setting, its current value and where it is stored."
  [apply]="apply <shell|hyprland|terminal> [--apply]
  Run what a settings change needs: restart the shell, reload Hyprland, or
  restart the terminals. A dry run by default: it names the exact command and
  runs nothing. shell restarts detached."
  [doctor]="doctor
  Check auth, that the remote really is private, the git hooks, file modes and
  version skew between machines. Read-only; it fixes nothing."
  [scope]="scope <id> shared|profile|off
  Who gets this file. shared: every machine. profile: each profile keeps its own
  copy, so neither overwrites the other. off: nobody backs it up."
  [policy]="policy set --scope <scope> -- <id...>
  Apply one validated scope decision to several tracked entries. The complete
  selection changes together and produces one repository-shape commit."
  [bulk]="bulk save|scope|track|convert-secret|untrack [options] -- <id...>
  Apply one validated multi-entry operation in one transaction and one commit.
  Destructive operations and tracking require --yes. Large files require
  --allow-large."
  [track]="track <path> [name-in-repo] [--secret]
  Add a file or a directory (trailing /) to YOUR list, which lives in your repo
  and travels to your other machines. --secret stores it under secrets/ at mode
  600 and keeps its contents out of every diff and every panel row."
  [untrack]="untrack <id>
  Drop one of your own entries AND its copy in the repo. Refuses entries that
  ship with the plugin — use 'scope <id> off' for those."
  [forget]="forget <id>
  For a file you deleted from this machine: its copy leaves the repo too, in one
  commit. One of your own entries is untracked. A shipped entry stays in the
  plugin's list, so it shows again if the file comes back. Git history keeps
  the copy: 'deleted' lists it and 'recover' brings it back."
  [deleted]="deleted [--json]
  Every copy that left your repo and is not back, grouped by the commit that
  removed it, newest first. Only the shared tree, the secrets and this
  profile's tree: another profile's files belong to another machine."
  [recover]="recover <sha> [--apply]
  Undo the deletions of one commit from 'deleted'. The copies come back into
  the repo, the entries that commit untracked are tracked again, and each file
  is put back on this machine with a .bak.<epoch> of what it replaces.
  A dry run by default."
  [update-check]="update-check [--fetch] [--json]
  Whether the plugin's origin has a newer version, and what it changes. It
  asks the origin at most every 6 hours, unless --fetch is given."
  [update]="update [--yes] [--restart]
  Install the newer version with 'omarchy plugin update', which validates it
  and rolls back a version that fails. Asks first, unless --yes is given.
  --restart restarts the shell afterwards, so that the new code loads."
  [suggest]="suggest [--json]
  Config on this machine that nothing is backing up yet, credentials first.
  It only proposes; nothing is tracked until you say so. It looks through
  ~/.config down two levels, ~/.local/bin and the Omarchy hooks — deeper
  files need the panel's file browser or track <path>."
  [profile]="profile [name]
  Show or set which profile this machine is in. Files scoped 'profile' are kept
  per profile, so a desktop and a laptop stop overwriting each other."
  [revert]="revert <setting-id> [--to default|repo]
  Put one setting back to Omarchy's default, or to what is saved in your repo."
  [restore-file]="restore-file <id>
  Bring one file or directory back from the repo, keeping a .bak.<epoch>."
  [shortcuts]="shortcuts [--json]
  Your own keybinding overrides, and what each key is bound to right now."
  [shortcut]="shortcut list [--json]
  shortcut add <keys> <command> [--desc text] [--apply]
  shortcut disable <keys> [--apply]
  shortcut restore <keys> [--apply]
  shortcut remove <keys> [--apply]
  Deterministic keybinding edits in hypr/bindings.lua. Replicant owns one
  managed block at the end of the file; everything outside it is left
  byte-for-byte alone. Every mutation prints its preview first and writes
  only with --apply, then saves hypr/bindings.lua through the repo.
  add refuses keys that are already bound. disable silences a binding with
  hl.unbind, restore brings it back, and remove deletes a Replicant binding.
  Bindings that are yours (not Replicant's) are never touched."
  [compose]="compose list [--json]
  compose add '<sequence>' '<result>' [--apply]
  compose remove '<sequence>' [--apply]
  Deterministic compose-sequence edits in ~/.XCompose. Replicant owns one
  managed block; everything outside it is preserved. Every mutation prints
  its preview first and writes only with --apply, then applies
  omarchy-restart-xcompose and saves home/XCompose through the repo.
  add refuses a sequence that already exists. Sequences that are yours
  (not Replicant's) are never removed."
  [bar-layout]="bar-layout list [--json]
  bar-layout move <widget> --section <s> [--before x|--after x|--index n] [--apply]
  bar-layout enable <id> --section <s> [--apply]
  bar-layout disable <widget> [--apply]
  bar-layout spacer --section <s> [--size n] [--apply]
  Deterministic bar-layout edits in shell.json. A widget is an id
  (omarchy.clock) or a section:index pair (center:2, the only way to name a
  spacer). Every mutation prints its preview first and writes only with
  --apply, then saves omarchy/shell.json through the repo. The shell watches
  the file, so no reload is needed. enable refuses a widget that is already
  on the bar; disable removes it from the bar (the plugin stays installed)."
  [workspace]="workspace list [--json]
  workspace define <n> [--name X] [--layout L] [--persistent on|off] [--apply]
  workspace undefine <n> [--apply]
  workspace count <n> [--apply]
  workspace app-add <class> <n> [--apply]
  workspace app-remove <class> [--apply]
  workspace assign <n> <monitor> [--default] [--apply]
  workspace unassign <n> [--apply]
  Profile-aware workspace editors. Application rules and workspace structure
  (names, layouts, keep-empty) are shared in hypr/hyprland.lua; monitor
  assignments are per-profile in hypr/monitors.lua. Replicant owns one
  managed block per concern; everything else is preserved byte-for-byte.
  Every mutation prints its preview first and writes only with --apply.
  define keeps the existing keep-empty answer when only renaming. count
  keeps workspaces 1..N alive and drops keep-empty above N. assign warns
  when the monitor is not connected, and --default moves the default flag
  from the other workspaces on that monitor. No desc: serial ever prints."
  [display]="display list [--json]
  display set <monitor> [--mode WxH@R|preferred] [--scale S] [--rotation 0-7]
    [--position XxY|auto] [--mirror M] [--vrr 0-2] [--hdr|--no-hdr] [--apply]
  display enable|disable <monitor> [--apply]
  display remove <monitor> [--apply]
  display default <monitor> [--apply]
  Per-profile display entries in hypr/monitors.lua. set merges into the
  managed entry (a connector name, never a desc: serial) and refuses modes
  the connected monitor does not offer, printing its capability first.
  disable and remove also work for a monitor that is not connected.
  default makes workspace 1 prefer that monitor in this profile.
  No desc: serial ever prints."
  [reconcile]="reconcile [--from <machine>] [--json]
  reconcile install <pkg...> [--aur] [--apply]
  Portable software reconciliation, presented as part of restore. The preview
  names the source machine (the newest save, or --from), lists missing
  official and AUR packages separately, and prints the exact official install
  command. install takes only named packages, refuses anything not missing,
  and never removes. Base and ignored packages are never proposed.
  Plugins and themes list with their origins; review one with
  install-plugin <id> --check before install-plugin --revision <sha> --yes."
  [link]="link
  Put replicant on your PATH at ~/.local/bin. The panel never needs
  this — it is for typing."
  [unlink]="unlink
  Remove that symlink again. Nothing else is touched."
  [purge]="purge [--apply] [--repo]
  Remove everything replicant put on this machine outside its own
  folder, including the .bak.<epoch> copies it left behind — even beside
  files nothing tracks anymore.
  --apply  actually delete (a dry run by default)
  --repo   also delete the local clone of your backup repo
  Your GitHub repo is never touched."
  [reset]="reset <id>
  Put one file back to Omarchy's default, keeping a .bak.<epoch>."
  [reset-all]="reset-all [--apply] [--yes]
  Put EVERY file with a known Omarchy default back to factory, keeping a
  .bak.<epoch> for each. Dry run by default; asks once, not per file.
  This is not the same thing as 'restore --apply --all', which brings back what
  is saved in your repo."
  [push]="push
  Push the commits that already exist. It copies nothing and commits nothing —
  when there is uncommitted work it says so and leaves it to save."
  [pull]="pull
  Bring down what another machine saved. It does not touch your files: run
  restore afterwards to put anything back."
  [clone]="clone <url>
  Point this machine at a repo you already have, and check that the clone
  actually landed on a branch with commits on it."
  [restore]="restore [--apply] [--all] [--only <area>] [--yes]
  Put back what is saved in your repo. A dry run by default, and every file it
  overwrites is kept as .bak.<epoch> first.
  Restoring is not copying: each area also runs what has to happen afterwards —
  hyprctl reload, a terminal restart, omarchy-theme-set. Third-party plugins
  and themes are NOT reinstalled by this command — see 'install-theme' /
  'install-plugin'. This is not the same thing as 'reset-all', which goes to
  Omarchy's defaults."
  [install-theme]="install-theme <name>
  Install one third-party theme recorded in your inventory, fetching whatever
  is at its origin right now. 'restore' only ever reports these as pending —
  this is the action that actually fetches one, on purpose."
  [install-plugin]="install-plugin <id> [--check]
  The same thing for a plugin: 'restore' reports it as pending, this installs
  it, fetching whatever is at its origin right now. It first says what the
  Omarchy marketplace checked, and whether the origin has moved since.
  --check  say that, and install nothing"
)


# Restore and reset are implemented by the core modules. Keep these wrappers
# near dispatch so the public CLI only forwards arguments and returns status.
cmd_restore() { ensure_core; bash "$CORE" restore "$@"; }
cmd_reset_all() { ensure_core; bash "$CORE" reset-all "$@"; }

main() {
  # Global streaming option for the panel. It must come before the command so
  # that it never collides with a commit message or a file path, and it is
  # exported so the core and every module see it. Human output is unchanged.
  if [[ "${1:-}" == "--progress-json" ]]; then
    export REPLICANT_PROGRESS_JSON=1
    shift
  fi
  local cmd="${1:-}"; [[ -z "$cmd" ]] && { usage; exit 0; }
  export REPLICANT_PROGRESS_COMMAND="$cmd"
  if [[ "${REPLICANT_PROGRESS_JSON:-0}" == 1 ]]; then
    trap progress_cli_exit EXIT
    progress_stage run false "Running"
  fi
  if [[ "${REPLICANT_PROCESS_GROUP:-0}" == 1 ]]; then
    trap 'progress_cli_cancel' INT TERM
  fi
  # Before the lock, and before anything else: help is not an action. `--help`
  # is reserved wherever it appears. `-h` stays a value after the command, so
  # settings and save messages can use it unchanged.
  local arg
  for arg in "${@:2}"; do
    [[ "$arg" == "--help" ]] || continue
    if [[ -n "${HELP[$cmd]:-}" ]]; then printf '%s\n' "${HELP[$cmd]}"; else usage; fi
    exit 0
  done
  if [[ "${2:-}" == "-h" ]]; then
    if [[ -n "${HELP[$cmd]:-}" ]]; then printf '%s\n' "${HELP[$cmd]}"; else usage; fi
    exit 0
  fi
  # Internal panel action. Keep it outside the public dispatcher so it does
  # not become a documented CLI command or part of the stable command surface.
  # Anything that writes to the repo takes the lock first; read-only commands
  # (status/get/diff/edit) stay lock-free so the panel's polling never blocks.
  # wants_apply <args...>: 0 when the effective mode writes. undo, backups,
  # purge and recover are dry runs by default and take --apply to write; a
  # later --dry-run wins over an earlier --apply, the way each command parses
  # them. Matching whole tokens, not substrings: an id that merely contains
  # "--apply" must not take the lock.
  wants_apply() {
    local wa wa_write=1
    for wa in "$@"; do
      case "$wa" in --apply) wa_write=0 ;; --dry-run) wa_write=1 ;; esac
    done
    return "$wa_write"
  }
  case "$cmd" in
    init|create|save|set|save-file|reset|reset-all|push|pull|clone|restore|scope|policy|bulk|track|untrack|forget|profile|revert|restore-file|install-theme|install-plugin|tx) acquire_repo_lock ;;
    # These write only when they apply. A dry run takes no lock: taking it
    # creates the lock file, and purge would then list its own lock.
    undo|backups|purge|recover|shortcut|compose|bar-layout|workspace|display)
      if [[ -d "$REPLICANT_HOME" ]] && wants_apply "$@"; then
        acquire_repo_lock
      fi ;;
  esac
  case "$cmd" in
    -h|--help|help) usage; exit 0;;
    init) shift; cmd_init "$@";;
    login) shift; cmd_login "$@";;
    create) shift; cmd_create "$@";;
    setup-status) shift; [[ "${1:-}" == "--json" ]] || fail "usage: setup-status --json"; cmd_setup_status;;
    changes) shift; cmd_changes "$@";;
    tx) shift; cmd_tx "$@";;
    save) shift; cmd_save "$@";;
    status) shift; cmd_status "$@";;
    get) shift; cmd_get "$@";;
    set) shift; cmd_set "$@";;
    diff) shift;
      if [[ $# -gt 0 ]]; then cmd_open_diff "$@"; else cmd_diff "$@"; fi
      ;;
    edit) shift; cmd_edit "$@";;
    path) shift; cmd_path "$@";;
    save-file) shift; cmd_save_file "$@";;
    log) shift; cmd_log "$@";;
    settings) shift; cmd_settings "$@";;
    apply) shift; cmd_apply "$@";;
    doctor) shift; cmd_doctor "$@";;
    scope) shift; cmd_scope "$@";;
    policy) shift; cmd_policy "$@";;
    bulk) shift; cmd_bulk "$@";;
    track) shift; cmd_track "$@";;
    untrack) shift; cmd_untrack "$@";;
    key) shift; cmd_key "$@";;
    forget) shift; cmd_forget "$@";;
    deleted) shift; cmd_deleted "$@";;
    recover) shift; cmd_recover "$@";;
    update-check) shift; cmd_update_check "$@";;
    update) shift; cmd_update "$@";;
    suggest) shift; cmd_suggest "$@";;
    # The panel's file picker. Not in usage(), like backups-json: it prints JSON
    # for the panel, and `track <path>` is what a person types.
    browse-json) ensure_core; bash "$CORE" browse "${2:-}";;
    profile) shift; cmd_profile "$@";;
    revert) shift; cmd_revert "$@";;
    restore-file) shift; cmd_restore_file "$@";;
    shortcuts) shift; cmd_shortcuts "$@";;
    shortcut) shift; cmd_shortcut "$@";;
    compose) shift; cmd_compose "$@";;
    bar-layout) shift; cmd_bar_layout "$@";;
    workspace) shift; cmd_workspace "$@";;
    display) shift; cmd_display "$@";;
    reconcile) shift; cmd_reconcile "$@";;
    link) shift; cmd_link "$@";;
    unlink) shift; cmd_unlink "$@";;
    backups) shift; cmd_backups "$@";;
    # The panel's own reader. Not in usage(): a JSON dump is not a thing anyone
    # types, and the surface a person reads should only carry what they can use.
    backups-json) ensure_core; bash "$CORE" backups-json;;
    undo) shift; cmd_undo "$@";;
    purge) shift; cmd_purge "$@";;
    reset) shift; cmd_reset "$@";;
    reset-all) shift; cmd_reset_all "$@";;
    push) shift; cmd_push "$@";;
    pull) shift; cmd_pull "$@";;
    clone) shift; cmd_clone "$@";;
    install-theme) shift; cmd_install_theme "$@";;
    install-plugin) shift; cmd_install_plugin "$@";;
    restore) shift; cmd_restore "$@";;
    *) fail "unknown command $cmd — --help";;
  esac
}
main "$@"
